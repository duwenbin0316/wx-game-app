<view class="pp-mask" wx:if="{{visible}}" catchtouchmove="noop">
  <view class="pp-sheet" catchtap="noop">
    <view class="pp-title">用户隐私保护提示</view>
    <view class="pp-body">
      <text class="pp-text">感谢使用 Game Hub。在使用相关功能前,请阅读并同意</text>
      <text class="pp-link" bindtap="onOpenContract">{{contractName}}</text>
      <text class="pp-text">。我们仅在你使用对应功能时收集必要信息(如昵称头像用于联机对战显示),不会用于其他用途。</text>
    </view>
    <text class="pp-reason" wx:if="{{reason}}">{{reason}}</text>
    <text class="pp-note">拒绝后仍可使用不涉及个人信息的功能。</text>
    <view class="pp-actions">
      <button class="pp-btn pp-disagree" bindtap="onDisagree">拒绝</button>
      <button id="privacy-agree-btn" class="pp-btn pp-agree"
              open-type="agreePrivacyAuthorization"
              bindagreeprivacyauthorization="onAgree">同意并继续</button>
    </view>
  </view>
</view>
