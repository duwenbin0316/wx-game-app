.pg-locked {
  padding: 24rpx;
  background: #16162A;
  border: 2rpx dashed #2E3A5C;
}

.pg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.pg-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pg-state {
  font-size: 22rpx;
  color: #F5C842;
  font-family: monospace;
}

.pg-denied { color: #FF6B6B; }

.pg-reason {
  display: block;
  font-size: 24rpx;
  color: #8A8ABA;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

.pg-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A2E;
  background: #A78BFA;
}

.pg-btn:active { opacity: 0.75; }

.pg-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(8, 8, 24, 0.66);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 900;
  padding: 0 60rpx;
}

.pg-dialog {
  width: 100%;
  padding: 40rpx 36rpx 32rpx;
  background: #1E1E38;
  border: 2rpx solid #A78BFA;
  box-shadow: 6rpx 6rpx 0 #0E0E22;
}

.pg-d-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.pg-d-text {
  display: block;
  font-size: 26rpx;
  color: #C0C0E8;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.pg-d-muted { color: #6A6A9A; font-size: 23rpx; }

.pg-d-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.pg-d-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 700;
}

.pg-d-cancel {
  color: #8A8ABA;
  background: #16162A;
  border: 2rpx solid #2E3A5C;
}

.pg-d-ok {
  color: #1A1A2E;
  background: #A78BFA;
}
