<view class="pg">
  <view wx:if="{{status === 'authorized'}}"><slot></slot></view>
  <view wx:else class="pg-locked">
    <view class="pg-head">
      <text class="pg-name">{{name}}</text>
      <text class="pg-state {{status === 'denied' ? 'pg-denied' : ''}}">{{status === 'denied' ? '已拒绝' : (status === 'notAsked' ? '未授权' : '检查中')}}</text>
    </view>
    <text class="pg-reason">{{reason}}</text>
    <view class="pg-btn" bindtap="onRequest">{{status === 'denied' ? '去设置开启' : '开启' + name}}</view>
  </view>

  <!-- 申请说明弹窗:先告诉用户为什么要这个权限,再调系统授权 -->
  <view class="pg-mask" wx:if="{{dialog}}" catchtouchmove="noop">
    <view class="pg-dialog" catchtap="noop">
      <text class="pg-d-title">申请{{name}}权限</text>
      <text class="pg-d-text">用途:{{reason}}</text>
      <text class="pg-d-text" wx:if="{{status === 'denied'}}">你之前拒绝过该权限,需要到设置页手动开启。</text>
      <text class="pg-d-text pg-d-muted" wx:else>下一步将弹出微信的系统授权框,你可以随时在设置中关闭。</text>
      <view class="pg-d-actions">
        <view class="pg-d-btn pg-d-cancel" bindtap="onDialogCancel">暂不</view>
        <view class="pg-d-btn pg-d-ok" bindtap="onDialogConfirm">{{status === 'denied' ? '去设置' : '继续'}}</view>
      </view>
    </view>
  </view>
</view>
