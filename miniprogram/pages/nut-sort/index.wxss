@import "../../styles/wood.wxss";
page { background: #26150A; }
.nuts-page { overflow: hidden; }
.nuts-header { padding: 16rpx 24rpx 18rpx; }
.nuts-stat { display: flex; flex-direction: column; align-items: center; min-width: 116rpx; }
.nuts-total { font-size: 22rpx; color: #DEBF90; }
.nuts-level-btn { font-size: 24rpx; }
.nuts-caption { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 20rpx 30rpx 6rpx; }
.nuts-caption-actions { display: flex; align-items: center; gap: 8rpx; }
.nuts-small { font-size: 21rpx; color: #C4A37A; padding: 12rpx; min-height: 44rpx; }
.nuts-help { color: #E6C68E; }
.nuts-canvas { flex: 1; width: 100%; height: 0; min-height: 0; display: block; }
.nuts-tip { display: flex; align-items: center; justify-content: center; text-align: center; padding: 14rpx 30rpx 20rpx; min-height: 70rpx; box-sizing: border-box; color: #D7B98D; font-size: 22rpx; line-height: 1.6; flex-shrink: 0; }
.nuts-console { padding: 26rpx 30rpx 20rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.nuts-keys { display: flex; gap: 24rpx; }
.nuts-key { flex: 1; height: 86rpx; font-size: 26rpx; }
.nuts-key-icon { font-size: 34rpx; }
.nuts-disabled { opacity: 0.42; }
.nuts-footnote { display: block; text-align: center; padding-top: 22rpx; font-size: 19rpx; color: #C39E70; letter-spacing: 2rpx; }
.nuts-plaque { max-height: 90%; width: 640rpx; }
.nuts-win-mark { color: #DDA94E; font-size: 60rpx; padding-bottom: 18rpx; }
.nuts-score-unit { font-size: 28rpx; }
.nuts-level-body { padding: 24rpx 28rpx 32rpx; }
.nuts-level-scroll { width: 100%; height: 480rpx; max-height: 42vh; padding-top: 20rpx; box-sizing: border-box; }
.nuts-level-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 8rpx 4rpx; }
.nuts-level { width: 17%; padding: 16rpx 0; box-sizing: border-box; margin-bottom: 18rpx; display: flex; align-items: center; flex-direction: column; background: #B88149; border: 2rpx solid #5F351B; border-radius: 10rpx; box-shadow: 0 5rpx 0 #5B3219; }
.nuts-level-number { color: #FFEBC3; font-size: 28rpx; font-weight: bold; }
.nuts-level-best { color: #5B351B; padding-top: 4rpx; font-size: 17rpx; }
.nuts-locked { opacity: 0.4; }
.nuts-current { border-color: #FFE4A0; background: #9B693A; }
.nuts-current .nuts-level-best { color: #F3D39F; }
.nuts-instructions { width: 100%; padding-bottom: 24rpx; }
.nuts-instructions text { display: block; color: #E5C598; font-size: 25rpx; line-height: 2.2; }
@media (max-height: 600px) {
  .nuts-header { padding-top: 10rpx; padding-bottom: 10rpx; }
  .nuts-caption { padding-top: 8rpx; }
  .nuts-console { padding-top: 18rpx; }
  .nuts-key { height: 72rpx; }
  .nuts-footnote { padding-top: 15rpx; }
}
