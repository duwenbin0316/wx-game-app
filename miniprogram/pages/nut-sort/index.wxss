/* 木质 3D 主题：通用部分在 styles/wood.wxss，这里只放螺母游戏自己的极简布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.nuts-page {
  overflow: hidden;
}

/* ── 顶部信息栏（对齐推箱子） ── */
.header-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.header-level {
  font-size: 34rpx;
}

.header-name {
  font-size: 22rpx;
}

.header-steps {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFF0D2;
  font-family: monospace;
  text-shadow: 0 2rpx 0 #4A2810;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.header-mute {
  width: auto;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.header-select {
  width: auto;
  height: 68rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

/* ── 画布 ── */
.nuts-canvas {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  display: block;
}

/* ── 底部控制台 ── */
.nuts-console {
  padding: 28rpx 30rpx 36rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.nuts-keys {
  display: flex;
  gap: 24rpx;
}

.nuts-key {
  flex: 1;
  height: 92rpx;
}

.nuts-key .wood-key-text {
  font-size: 28rpx;
}

/* ── 通关与选关面板 ── */
.score-unit {
  font-size: 40rpx;
}

.select-plaque {
  width: 640rpx;
}

.select-body {
  padding: 28rpx 32rpx 40rpx;
}

.select-scroll {
  width: 100%;
  height: 520rpx;
  max-height: 46vh;
  margin-bottom: 28rpx;
}

.select-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  padding: 8rpx 0 12rpx;
}

.select-item {
  width: 98rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #E2B37A 0%, #C48C52 60%, #AE7640 100%);
  border: 2rpx solid #5E3519;
  box-shadow: 0 6rpx 0 #5A3218, 0 8rpx 10rpx rgba(0, 0, 0, 0.35), inset 0 2rpx 0 rgba(255, 244, 220, 0.6);
  box-sizing: border-box;
}

.select-item:active {
  transform: translateY(5rpx);
  box-shadow: 0 1rpx 0 #5A3218, inset 0 3rpx 6rpx rgba(80, 40, 10, 0.35);
}

.item-locked {
  opacity: 0.42;
  background: linear-gradient(180deg, #8F6A48 0%, #6E4E33 100%);
}

.item-current {
  background: linear-gradient(180deg, #FFE18A 0%, #E0A93E 100%);
  border-color: #7A5212;
  box-shadow: 0 6rpx 0 #7A5212, 0 8rpx 10rpx rgba(0, 0, 0, 0.35), inset 0 2rpx 0 rgba(255, 250, 230, 0.7);
}

.select-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2810;
  font-family: monospace;
  text-shadow: 0 2rpx 0 rgba(255, 238, 210, 0.5);
}

.select-best {
  font-size: 17rpx;
  color: #6B2A14;
  font-weight: 700;
  font-family: monospace;
}
