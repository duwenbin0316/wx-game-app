page, .nuts-page { background: #f6f2e9; color: #2d352e; }
.nuts-page {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.nuts-header, .bench-stats, .nuts-console { flex-shrink: 0; }
.nuts-header, .header-actions, .bench-stats, .stat, .nuts-keys {
  display: flex;
  align-items: center;
}
.nuts-header { justify-content: space-between; padding: 20rpx 40rpx 22rpx; }
.chapter { display: flex; flex-direction: column; gap: 6rpx; }
.chapter-index {
  color: #924a31;
  font-size: 23rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}
.chapter-name, .plaque-title {
  font-family: "Songti SC", "Noto Serif CJK SC", SimSun, serif;
  font-weight: 600;
  font-size: 50rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.header-actions { gap: 10rpx; }
.header-button, .nuts-key, .wbtn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.header-button { min-width: 88rpx; height: 76rpx; color: #57584d; }
.chapter-button { border: 2rpx solid #c8bfae; border-radius: 40rpx; min-width: 108rpx; }
.bench-stats {
  margin: 0 40rpx;
  padding: 15rpx 0;
  justify-content: space-between;
  border-top: 2rpx solid #cec6b6;
}
.stat { gap: 13rpx; color: #65665a; font-size: 23rpx; }
.stat-value {
  font-family: Georgia, "Times New Roman", serif;
  font-variant-numeric: tabular-nums;
  font-size: 31rpx;
  color: #2c3a31;
}
.nuts-canvas { flex: 1; width: 100%; height: 0; min-height: 0; display: block; }
.nuts-console {
  padding: 18rpx 40rpx 26rpx;
  padding-bottom: calc(26rpx + env(safe-area-inset-bottom));
}
.bench-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  line-height: 1.4;
  color: #55594d;
  text-align: center;
  font-size: 24rpx;
}
.nuts-keys { gap: 14rpx; padding-top: 12rpx; }
.nuts-key, .wbtn {
  border: 2rpx solid #c9c1b1;
  border-radius: 12rpx;
  color: #333c33;
  font-weight: 600;
  background: #f8f4ec;
}
.nuts-key { flex: 1; height: 82rpx; }
.key-primary, .wbtn-primary { background: #304e43; border-color: #304e43; color: #fff8e9; }
.nuts-key:active, .wbtn:active, .header-button:active, .select-item:active { opacity: 0.72; }
.key-disabled { color: #928f82; background: #ebe6db; border-color: #e0d9cc; }

.overlay {
  position: fixed;
  top: 0; bottom: 0; left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(38, 41, 33, 0.48);
  z-index: 10;
}
.plaque {
  width: 578rpx;
  max-height: 90%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f8f4eb;
  box-shadow: 0 18rpx 60rpx rgba(45, 36, 24, 0.22);
}
.plaque-head { padding: 32rpx 36rpx 24rpx; border-bottom: 2rpx solid #d9d0c0; }
.plaque-title { font-size: 40rpx; }
.plaque-body, .stat-cell, .select-item { display: flex; flex-direction: column; align-items: center; }
.plaque-body { padding: 30rpx 36rpx; }
.newbest-badge, .score-label { color: #8c5035; font-size: 24rpx; }
.score-num { font: 76rpx Georgia, serif; color: #304e43; margin-top: 8rpx; }
.score-unit { font-size: 28rpx; }
.stat-grid, .btn-col { display: flex; align-items: center; width: 100%; gap: 16rpx; }
.stat-grid { padding: 20rpx 0 32rpx; }
.stat-cell { flex: 1; gap: 4rpx; }
.cell-label, .select-best { font-size: 22rpx; color: #69695b; }
.cell-value, .select-num { font: 34rpx Georgia, serif; color: #334338; }
.wbtn { flex: 1; height: 80rpx; }
.select-plaque { width: 648rpx; }
.select-scroll { width: 100%; height: 510rpx; max-height: 45vh; margin-bottom: 22rpx; }
.select-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; }
.select-item {
  box-sizing: border-box;
  width: 102rpx;
  height: 92rpx;
  justify-content: center;
  background: #e9e3d7;
  border-radius: 8rpx;
}
.select-best { font-size: 18rpx; }
.item-locked { background: #eeeae1; }
.item-locked .select-num, .item-locked .select-best { color: #847e71; }
.item-current { background: #304e43; }
.item-current .select-num, .item-current .select-best { color: #fff6e4; }
