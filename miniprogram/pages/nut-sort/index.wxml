<view class="wood-page nuts-page">
  <!-- 顶部木条：对齐推箱子极简布局 -->
  <view class="wood-header game-header">
    <view class="header-left">
      <text class="head-value head-gold header-level">{{level}}/{{levelCount}}</text>
      <text class="head-label header-name">{{levelName}}</text>
    </view>
    <text class="header-steps">{{steps}} 步 · 最优 {{par}}</text>
    <view class="header-actions">
      <view class="wood-knob header-mute" bindtap="onMute">{{muted ? '静音' : '音效'}}</view>
      <view class="wood-knob header-select" bindtap="onShowLevels">选关</view>
    </view>
  </view>

  <canvas
    id="nut-canvas"
    type="2d"
    class="nuts-canvas"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchCancel"
  ></canvas>

  <!-- 底部木质按键：无多余口号与提示条 -->
  <view class="wood-console nuts-console">
    <view class="nuts-keys">
      <view class="wood-key nuts-key {{canUndo ? '' : 'wood-key-disabled'}}" bindtap="onUndo">
        <text class="wood-key-text">↩ 撤销</text>
      </view>
      <view class="wood-key nuts-key {{hintBusy ? 'wood-key-disabled' : ''}}" bindtap="onHint">
        <text class="wood-key-text">{{hintBusy ? '寻找中' : '提示'}}</text>
      </view>
      <view class="wood-key wood-key-red nuts-key" bindtap="onRestart">
        <text class="wood-key-text wood-key-text-light">↻ 重开</text>
      </view>
    </view>
  </view>

  <!-- 通关木牌 -->
  <view class="overlay" wx:if="{{gameState === 'win'}}" catchtouchmove="noop">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">{{level === levelCount ? '全部完成' : (steps <= par ? '完美通关' : '通关')}}</text>
      </view>
      <view class="plaque-body">
        <view class="newbest-badge" wx:if="{{steps <= par || isNewBest}}">
          <text class="newbest-text">{{steps <= par ? '★ 最优步数' : '★ 新纪录'}}</text>
        </view>
        <text class="score-label" wx:else>{{levelName}} · 用了</text>
        <text class="score-num">{{steps}}<text class="score-unit"> 步</text></text>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="cell-label">最优</text>
            <text class="cell-value">{{par}}</text>
          </view>
          <view class="stat-cell">
            <text class="cell-label">个人纪录</text>
            <text class="cell-value">{{best > 0 ? best : '-'}}</text>
          </view>
        </view>
        <view class="btn-col">
          <view class="wbtn wbtn-primary" bindtap="onNext">{{level === levelCount ? '回顾关卡' : '下一关 ›'}}</view>
          <view class="wbtn" bindtap="onRestart">重玩</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选关木牌 -->
  <view class="overlay" wx:if="{{showLevels}}" catchtouchmove="noop" bindtap="onCloseLevels">
    <view class="plaque select-plaque" catchtap="noop">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">选择关卡</text>
      </view>
      <view class="plaque-body select-body">
        <scroll-view scroll-y="true" class="select-scroll">
          <view class="select-grid">
            <view
              wx:for="{{levelList}}"
              wx:key="index"
              class="select-item {{item.locked ? 'item-locked' : ''}} {{item.current ? 'item-current' : ''}}"
              data-index="{{item.index}}"
              bindtap="onPickLevel"
            >
              <text class="select-num">{{item.locked ? '🔒' : item.label}}</text>
              <text class="select-best">{{item.locked ? '' : (item.best > 0 ? item.best + '步' : '待玩')}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="btn-col">
          <view class="wbtn" bindtap="onCloseLevels">关闭</view>
        </view>
      </view>
    </view>
  </view>
</view>
