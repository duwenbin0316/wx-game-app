<view class="nuts-page">
  <view class="nuts-header">
    <view class="chapter">
      <text class="chapter-index">第 {{level}} 关</text>
      <text class="chapter-name">{{levelName}}</text>
    </view>
    <view class="header-actions">
      <view class="header-button" bindtap="onMute">{{muted ? '静音' : '音效'}}</view>
      <view class="header-button chapter-button" bindtap="onShowLevels">选关</view>
    </view>
  </view>
  <view class="bench-stats">
    <view class="stat"><text>步数</text><text class="stat-value">{{steps}}</text></view>
    <view class="stat"><text>目标</text><text class="stat-value">{{par}}</text></view>
    <view class="stat"><text>归位</text><text class="stat-value">{{completed}} / {{colors}}</text></view>
  </view>

  <canvas
    id="nut-canvas"
    type="2d"
    class="nuts-canvas"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchCancel"
  ></canvas>

  <view class="nuts-console">
    <text class="bench-tip">{{tip}}</text>
    <view class="nuts-keys">
      <view class="nuts-key {{canUndo ? '' : 'key-disabled'}}" bindtap="onUndo">撤销</view>
      <view class="nuts-key key-primary {{hintBusy ? 'key-disabled' : ''}}" bindtap="onHint">{{hintBusy ? '寻找中' : '提示'}}</view>
      <view class="nuts-key" bindtap="onRestart">重开</view>
    </view>
  </view>

  <!-- 通关木牌 -->
  <view class="overlay" wx:if="{{gameState === 'win'}}" catchtouchmove="noop">
    <view class="plaque">
      <view class="plaque-head">
        <text class="plaque-title">{{level === levelCount ? '全部完成' : (steps <= par ? '完美通关' : '通关')}}</text>
      </view>
      <view class="plaque-body">
        <view class="newbest-badge" wx:if="{{steps <= par || isNewBest}}">
          <text class="newbest-text">{{steps <= par ? '★ 达成目标' : '★ 新纪录'}}</text>
        </view>
        <text class="score-label" wx:else>{{levelName}} · 用了</text>
        <text class="score-num">{{steps}}<text class="score-unit"> 步</text></text>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="cell-label">目标步数</text>
            <text class="cell-value">{{par}}</text>
          </view>
          <view class="stat-cell">
            <text class="cell-label">个人纪录</text>
            <text class="cell-value">{{best > 0 ? best : '-'}}</text>
          </view>
        </view>
        <view class="btn-col">
          <view class="wbtn wbtn-primary" bindtap="onNext">{{level === levelCount ? '回顾关卡' : '下一关 ›'}}</view>
          <view class="wbtn" bindtap="onRestart">重玩</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选关木牌 -->
  <view class="overlay" wx:if="{{showLevels}}" catchtouchmove="noop" bindtap="onCloseLevels">
    <view class="plaque select-plaque" catchtap="noop">
      <view class="plaque-head">
        <text class="plaque-title">选择关卡</text>
      </view>
      <view class="plaque-body select-body">
        <scroll-view scroll-y="true" class="select-scroll">
          <view class="select-grid">
            <view
              wx:for="{{levelList}}"
              wx:key="index"
              class="select-item {{item.locked ? 'item-locked' : ''}} {{item.current ? 'item-current' : ''}}"
              data-index="{{item.index}}"
              bindtap="onPickLevel"
            >
              <text class="select-num">{{item.label}}</text>
              <text class="select-best">{{item.locked ? '未解锁' : (item.best > 0 ? item.best + '步' : '待玩')}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="btn-col">
          <view class="wbtn" bindtap="onCloseLevels">关闭</view>
        </view>
      </view>
    </view>
  </view>
</view>
