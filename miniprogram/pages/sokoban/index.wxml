<view class="wood-page sokoban-container" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">

  <!-- 顶部木条 -->
  <view class="wood-header game-header">
    <view class="header-left">
      <text class="head-value head-gold header-level">{{levelIndex + 1}}/{{levelCount}}</text>
      <text class="head-label header-name">{{levelName}}</text>
    </view>
    <text class="header-steps">{{steps}} 步 · 最优 {{par}}</text>
    <view class="wood-knob header-select" catchtouchend="onSelectShow">选关</view>
  </view>

  <canvas id="sokoban-canvas" type="2d" class="sokoban-canvas"></canvas>

  <!-- 方向控制键 + 撤销/重开。非游戏中只隐藏不移除,免得画布变高被拉伸 -->
  <view class="wood-console controls {{gameState === 'playing' ? '' : 'controls-hidden'}}" catchtouchend="noop">
    <view class="dpad">
      <view class="wood-key dpad-key" catchtouchstart="onUp"><view class="arr arr-up"></view></view>
      <view class="dpad-row">
        <view class="wood-key dpad-key" catchtouchstart="onLeft"><view class="arr arr-left"></view></view>
        <view class="dpad-center"></view>
        <view class="wood-key dpad-key" catchtouchstart="onRight"><view class="arr arr-right"></view></view>
      </view>
      <view class="wood-key dpad-key" catchtouchstart="onDown"><view class="arr arr-down"></view></view>
    </view>
    <view class="side-btns">
      <view class="wood-key side-key" catchtouchstart="onUndo"><text class="wood-key-text">↩ 撤销</text></view>
      <view class="wood-key wood-key-red side-key" catchtouchstart="onRestartLevel"><text class="wood-key-text wood-key-text-light">↻ 重开</text></view>
    </view>
  </view>

  <!-- 通关 -->
  <view class="overlay" wx:if="{{gameState === 'win'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">{{isAllDone ? '全部完成' : (isPerfect ? '完美通关' : '通关')}}</text>
      </view>
      <view class="plaque-body">
        <view class="newbest-badge" wx:if="{{isPerfect}}">
          <text class="newbest-text">★ 最优步数</text>
        </view>
        <text class="score-label" wx:else>{{levelName}} · 用了</text>
        <text class="score-num">{{steps}}<text class="score-unit"> 步</text></text>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="cell-label">最优</text>
            <text class="cell-value">{{par}}</text>
          </view>
          <view class="stat-cell">
            <text class="cell-label">个人纪录</text>
            <text class="cell-value">{{best > 0 ? best : '-'}}</text>
          </view>
        </view>
        <view class="btn-col">
          <view class="wbtn wbtn-primary" catchtouchstart="onNext" wx:if="{{!isAllDone}}">下一关 ›</view>
          <view class="wbtn" catchtouchstart="onRestart">{{isAllDone ? '再来一遍' : '重玩'}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选关面板 -->
  <view class="overlay" wx:if="{{showSelect}}" catchtouchend="onSelectClose">
    <view class="plaque select-plaque" catchtouchend="noop">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">选择关卡</text>
      </view>
      <view class="plaque-body">
        <view class="select-grid">
          <view
            wx:for="{{levelList}}"
            wx:key="index"
            class="select-item {{item.locked ? 'item-locked' : ''}} {{item.current ? 'item-current' : ''}}"
            data-index="{{item.index}}"
            catchtouchend="onSelectLevel"
          >
            <text class="select-num">{{item.locked ? '🔒' : item.index + 1}}</text>
            <text class="select-name">{{item.name}}</text>
            <text class="select-best" wx:if="{{item.best > 0}}">{{item.best}}步</text>
          </view>
        </view>
        <view class="btn-col btn-col-gap">
          <view class="wbtn" catchtouchend="onSelectClose">关闭</view>
        </view>
      </view>
    </view>
  </view>
</view>
