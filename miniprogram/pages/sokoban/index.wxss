/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放推箱子自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

/* ── 顶部信息栏 ── */
.header-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.header-level {
  font-size: 34rpx;
}

.header-name {
  font-size: 22rpx;
}

.header-steps {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFF0D2;
  font-family: monospace;
  text-shadow: 0 2rpx 0 #4A2810;
}

.header-select {
  width: auto;
  padding: 0 28rpx;
  font-size: 28rpx;
}

/* ── 游戏画布 ── */
.sokoban-canvas {
  width: 100%;
  flex: 1;
  display: block;
  min-height: 0;
}

/* ── 控制区 ── */
.controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 44rpx;
}

.controls-hidden { visibility: hidden; }

.dpad {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.dpad-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

/* 方向键做大:单键约 72×62px,拇指好按 */
.dpad-key {
  width: 144rpx;
  height: 124rpx;
}

.dpad-key .arr-up    { border-left-width: 22rpx; border-right-width: 22rpx; border-bottom-width: 30rpx; }
.dpad-key .arr-down  { border-left-width: 22rpx; border-right-width: 22rpx; border-top-width: 30rpx; }
.dpad-key .arr-left  { border-top-width: 22rpx; border-bottom-width: 22rpx; border-right-width: 30rpx; }
.dpad-key .arr-right { border-top-width: 22rpx; border-bottom-width: 22rpx; border-left-width: 30rpx; }

.dpad-center {
  width: 144rpx;
  height: 124rpx;
}

/* ── 撤销/重开按钮 ── */
.side-btns {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.side-key {
  width: 200rpx;
  height: 120rpx;
}

.side-key .wood-key-text {
  font-size: 32rpx;
}

/* ── 通关 ── */
.score-unit {
  font-size: 40rpx;
}

/* ── 选关面板 ── */
.select-plaque {
  width: 640rpx;
}

.select-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  justify-content: center;
}

/* 每关一块小木片 */
.select-item {
  width: 104rpx;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #E2B37A 0%, #C48C52 60%, #AE7640 100%);
  border: 2rpx solid #5E3519;
  box-shadow: 0 6rpx 0 #5A3218, 0 8rpx 10rpx rgba(0, 0, 0, 0.35), inset 0 2rpx 0 rgba(255, 244, 220, 0.6);
  box-sizing: border-box;
}

.select-item:active {
  transform: translateY(5rpx);
  box-shadow: 0 1rpx 0 #5A3218, inset 0 3rpx 6rpx rgba(80, 40, 10, 0.35);
}

.item-locked {
  opacity: 0.45;
  background: linear-gradient(180deg, #8F6A48 0%, #6E4E33 100%);
}

.item-current {
  background: linear-gradient(180deg, #FFE18A 0%, #E0A93E 100%);
  border-color: #7A5212;
  box-shadow: 0 6rpx 0 #7A5212, 0 8rpx 10rpx rgba(0, 0, 0, 0.35), inset 0 2rpx 0 rgba(255, 250, 230, 0.7);
}

.select-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A2810;
  font-family: monospace;
  text-shadow: 0 2rpx 0 rgba(255, 238, 210, 0.5);
}

.select-name {
  font-size: 17rpx;
  color: #5A3216;
  font-family: monospace;
}

.select-best {
  font-size: 16rpx;
  color: #7A2A14;
  font-weight: 700;
  font-family: monospace;
}
