.racing-container {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #1A1A2E;
  overflow: hidden;
  touch-action: manipulation;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ── 暂停键 ── */
.pause-btn {
  position: fixed;
  top: 16rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(22, 22, 46, 0.7);
  border: 2rpx solid rgba(74, 111, 165, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 6;
  box-shadow: 3rpx 3rpx 0 rgba(10, 10, 26, 0.6);
}

.pause-btn:active { background: rgba(217, 119, 87, 0.25); }

.pause-bar {
  width: 8rpx;
  height: 28rpx;
  background: #4A6FA5;
}

/* ── 转向面板:一整块,拇指滑动即可换向 ── */
/* 注意:left / width 与 index.js 里的 PAD_LEFT_RPX / PAD_W_RPX 对应 */
.steer-pad {
  position: fixed;
  left: 24rpx;
  bottom: 36rpx;
  width: 320rpx;
  height: 168rpx;
  display: flex;
  align-items: stretch;
  background: rgba(22, 22, 46, 0.7);
  border: 2rpx solid rgba(74, 111, 165, 0.6);
  box-shadow: 3rpx 3rpx 0 rgba(10, 10, 26, 0.6);
  user-select: none;
  z-index: 5;
}

.steer-half {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.steer-active {
  background: rgba(217, 119, 87, 0.28);
}

.steer-split {
  width: 2rpx;
  background: rgba(74, 111, 165, 0.4);
}

/* ── 右侧:氮气 + 刹车 ── */
.ctrl-right {
  position: fixed;
  right: 24rpx;
  bottom: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-end;
  z-index: 5;
}

.brake-btn, .nitro-btn {
  width: 196rpx;
  background: rgba(22, 22, 46, 0.72);
  border: 2rpx solid rgba(74, 111, 165, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  user-select: none;
  box-shadow: 3rpx 3rpx 0 rgba(10, 10, 26, 0.6);
}

.brake-btn {
  height: 108rpx;
  border-color: rgba(255, 107, 107, 0.65);
}

.brake-btn:active {
  background: rgba(255, 107, 107, 0.28);
  border-color: #FF6B6B;
}

.brake-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
  font-family: monospace;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.brake-hint {
  font-size: 17rpx;
  color: rgba(255, 107, 107, 0.6);
  font-family: monospace;
}

.nitro-btn {
  height: 92rpx;
}

.nitro-btn:active { opacity: 0.75; }

/* 有氮气可用时高亮,用完变灰 */
.nitro-on {
  border-color: rgba(96, 192, 255, 0.85);
  background: rgba(96, 192, 255, 0.16);
}

.nitro-off {
  border-color: rgba(96, 192, 255, 0.25);
  opacity: 0.45;
}

.nitro-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #60C0FF;
  font-family: monospace;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.nitro-num {
  font-size: 20rpx;
  color: #60C0FF;
  font-family: monospace;
  line-height: 1;
}

.arr { display: block; width: 0; height: 0; }
.arr-left  { border-top: 20rpx solid transparent; border-bottom: 20rpx solid transparent; border-right: 28rpx solid #4A6FA5; }
.arr-right { border-top: 20rpx solid transparent; border-bottom: 20rpx solid transparent; border-left:  28rpx solid #4A6FA5; }

/* ── 覆盖层 ── */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 10, 30, 0.78);
  z-index: 10;
}

.overlay-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 56rpx 46rpx;
  background: rgba(30, 30, 60, 0.96);
  border: 2rpx solid #4A6FA5;
  border-radius: 0;
  min-width: 540rpx;
  box-shadow: 6rpx 6rpx 0 #0E0E22;
}

.overlay-logo {
  font-size: 60rpx;
  margin-bottom: 14rpx;
  line-height: 1;
}

.overlay-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  font-family: monospace;
  margin-bottom: 10rpx;
}

.overlay-sub {
  font-size: 20rpx;
  color: #A78BFA;
  letter-spacing: 3rpx;
  font-family: monospace;
  margin-bottom: 42rpx;
}

.hint-row {
  background: #D97757;
  padding: 16rpx 64rpx;
  margin-bottom: 22rpx;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.hint-row:active { opacity: 0.8; }

.hint-text {
  font-size: 32rpx;
  color: #1A1A2E;
  font-weight: 700;
  letter-spacing: 6rpx;
  font-family: monospace;
}

.hint-small {
  font-size: 20rpx;
  color: #6A6A9A;
  letter-spacing: 1rpx;
  font-family: monospace;
  margin-bottom: 6rpx;
}

.hint-best {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #F5C842;
  font-family: monospace;
}

/* ── 暂停面板 ── */
.pause-card { border-color: #4A6FA5; }

.pause-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #C0C0E8;
  letter-spacing: 10rpx;
  font-family: monospace;
  margin-bottom: 18rpx;
}

.ghost-btn {
  flex: 1;
  background: #1E1E38;
  border: 2rpx solid #2E3A5C;
  padding: 18rpx 0;
  text-align: center;
  user-select: none;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.ghost-btn:active { opacity: 0.7; }

.ghost-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A6FA5;
  letter-spacing: 3rpx;
  font-family: monospace;
}

/* ── 结算 ── */
.over-card { border-color: #F5C842; }

.over-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #F5C842;
  letter-spacing: 8rpx;
  font-family: monospace;
  margin-bottom: 20rpx;
}

.newbest-badge {
  padding: 6rpx 24rpx;
  background: rgba(245, 200, 66, 0.12);
  border: 2rpx solid #F5C842;
  margin-bottom: 14rpx;
}

.newbest-text {
  font-size: 24rpx;
  color: #F5C842;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.over-score-num {
  font-size: 78rpx;
  font-weight: 700;
  color: #D97757;
  font-family: monospace;
  line-height: 1.1;
}

.over-score-label {
  font-size: 22rpx;
  color: #6A6A9A;
  font-family: monospace;
  margin-bottom: 10rpx;
}

.over-best {
  font-size: 22rpx;
  color: #C0C0E8;
  font-family: monospace;
  margin-bottom: 38rpx;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.retry-btn {
  flex: 1;
  background: #D97757;
  padding: 20rpx 0;
  text-align: center;
  user-select: none;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.retry-btn:active { opacity: 0.75; }

.retry-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A2E;
  letter-spacing: 4rpx;
  font-family: monospace;
}

.racing-share-btn {
  flex: 1;
  padding: 18rpx 0;
  background: transparent;
  border: 2rpx solid #4A6FA5;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A6FA5;
  letter-spacing: 4rpx;
  font-family: monospace;
  line-height: 1.4;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.racing-share-btn::after { border: none; }

.racing-share-btn:active { opacity: 0.75; }
