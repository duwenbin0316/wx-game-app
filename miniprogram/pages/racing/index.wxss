.racing-container {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #1A1A2E;
  overflow: hidden;
  touch-action: manipulation;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ── 暂停键 ── */
.pause-btn {
  position: fixed;
  top: 16rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(22, 22, 46, 0.7);
  border: 2rpx solid rgba(74, 111, 165, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 6;
  box-shadow: 3rpx 3rpx 0 rgba(10, 10, 26, 0.6);
}

.pause-btn:active { background: rgba(217, 119, 87, 0.25); }

.pause-bar {
  width: 8rpx;
  height: 28rpx;
  background: #4A6FA5;
}

/* ── 转向面板:一整块,拇指滑动即可换向 ── */
/* 注意:left / width 与 index.js 里的 PAD_LEFT_RPX / PAD_W_RPX 对应 */
.steer-pad {
  position: fixed;
  left: 24rpx;
  bottom: 36rpx;
  width: 320rpx;
  height: 168rpx;
  display: flex;
  align-items: stretch;
  background: rgba(22, 22, 46, 0.7);
  border: 2rpx solid rgba(74, 111, 165, 0.6);
  box-shadow: 3rpx 3rpx 0 rgba(10, 10, 26, 0.6);
  user-select: none;
  z-index: 5;
}

.steer-half {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.steer-active {
  background: rgba(217, 119, 87, 0.28);
}

.steer-split {
  width: 2rpx;
  background: rgba(74, 111, 165, 0.4);
}

/* ── 右侧:氮气 + 刹车 ── */
.ctrl-right {
  position: fixed;
  right: 24rpx;
  bottom: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-end;
  z-index: 5;
}

.brake-btn, .nitro-btn {
  width: 196rpx;
  background: rgba(22, 22, 46, 0.72);
  border: 2rpx solid rgba(74, 111, 165, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  user-select: none;
  box-shadow: 3rpx 3rpx 0 rgba(10, 10, 26, 0.6);
}

.brake-btn {
  height: 108rpx;
  border-color: rgba(255, 107, 107, 0.65);
}

.brake-btn:active {
  background: rgba(255, 107, 107, 0.28);
  border-color: #FF6B6B;
}

/* 漂移中:按钮变成火花的蓝色 */
.brake-drift {
  background: rgba(96, 192, 255, 0.22);
  border-color: #60C0FF;
}

.brake-drift .brake-text,
.brake-drift .brake-hint {
  color: #60C0FF;
}

.brake-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
  font-family: monospace;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.brake-hint {
  font-size: 16rpx;
  color: rgba(255, 107, 107, 0.6);
  font-family: monospace;
}

.nitro-btn {
  height: 92rpx;
}

.nitro-btn:active { opacity: 0.75; }

/* 有氮气可用时高亮,用完变灰 */
.nitro-on {
  border-color: rgba(96, 192, 255, 0.85);
  background: rgba(96, 192, 255, 0.16);
}

.nitro-off {
  border-color: rgba(96, 192, 255, 0.25);
  opacity: 0.45;
}

.nitro-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #60C0FF;
  font-family: monospace;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.nitro-num {
  font-size: 20rpx;
  color: #60C0FF;
  font-family: monospace;
  line-height: 1;
}

.arr { display: block; width: 0; height: 0; }
.arr-left  { border-top: 20rpx solid transparent; border-bottom: 20rpx solid transparent; border-right: 28rpx solid #4A6FA5; }
.arr-right { border-top: 20rpx solid transparent; border-bottom: 20rpx solid transparent; border-left:  28rpx solid #4A6FA5; }

/* ── 覆盖层 ── */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(10, 10, 30, 0.62);
  z-index: 10;
}

/* 开始画面:压暗得轻一些,露出背后自动巡航的赛道 */
.overlay-idle {
  justify-content: space-between;
  padding: 150rpx 0 120rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(8, 6, 24, 0.72) 0%, rgba(8, 6, 24, 0.15) 40%, rgba(8, 6, 24, 0.2) 60%, rgba(8, 6, 24, 0.8) 100%);
}

.title-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.zone-row {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.zone-tag {
  font-size: 20rpx;
  font-family: monospace;
  padding: 4rpx 12rpx;
  border: 2rpx solid;
  background: rgba(10, 10, 30, 0.6);
}

.zone-city   { color: #FF4FD8; border-color: #FF4FD8; }
.zone-coast  { color: #6FC8FF; border-color: #6FC8FF; }
.zone-tunnel { color: #F5C842; border-color: #F5C842; }
.zone-forest { color: #4CFF8A; border-color: #4CFF8A; }

.idle-card {
  background: rgba(22, 18, 48, 0.82);
}

.tip-list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.overlay-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 56rpx 46rpx;
  background: rgba(30, 30, 60, 0.96);
  border: 2rpx solid #4A6FA5;
  border-radius: 0;
  min-width: 540rpx;
  box-shadow: 6rpx 6rpx 0 #0E0E22;
}

.overlay-title {
  font-size: 84rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 12rpx;
  font-family: monospace;
  margin-bottom: 18rpx;
  text-shadow: 0 0 16rpx #FF4FD8, 0 0 36rpx rgba(255, 79, 216, 0.6), 4rpx 4rpx 0 #6E2FB0;
}

.overlay-sub {
  font-size: 22rpx;
  color: #6FC8FF;
  letter-spacing: 6rpx;
  font-family: monospace;
  margin-bottom: 12rpx;
  text-shadow: 0 0 10rpx rgba(111, 200, 255, 0.8);
}

.hint-row {
  background: #D97757;
  padding: 16rpx 64rpx;
  margin-bottom: 22rpx;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.hint-row:active { opacity: 0.8; }

.hint-text {
  font-size: 34rpx;
  color: #1A1A2E;
  font-weight: 700;
  letter-spacing: 6rpx;
  font-family: monospace;
}

.hint-small {
  font-size: 21rpx;
  color: #9A9ACA;
  letter-spacing: 1rpx;
  font-family: monospace;
  margin-bottom: 6rpx;
}

.hint-best {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #F5C842;
  font-family: monospace;
}

/* ── 暂停面板 ── */
.pause-card { border-color: #4A6FA5; }

.pause-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #C0C0E8;
  letter-spacing: 10rpx;
  font-family: monospace;
  margin-bottom: 18rpx;
}

.ghost-btn {
  flex: 1;
  background: #1E1E38;
  border: 2rpx solid #2E3A5C;
  padding: 18rpx 0;
  text-align: center;
  user-select: none;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.ghost-btn:active { opacity: 0.7; }

.ghost-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A6FA5;
  letter-spacing: 3rpx;
  font-family: monospace;
}

/* ── 结算 ── */
.over-card { border-color: #F5C842; }

.over-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #F5C842;
  letter-spacing: 8rpx;
  font-family: monospace;
  margin-bottom: 20rpx;
}

.newbest-badge {
  padding: 6rpx 24rpx;
  background: rgba(245, 200, 66, 0.12);
  border: 2rpx solid #F5C842;
  margin-bottom: 14rpx;
}

.newbest-text {
  font-size: 24rpx;
  color: #F5C842;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

.grade {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid;
  box-shadow: 4rpx 4rpx 0 #0E0E22;
}

.grade-text {
  font-size: 80rpx;
  font-weight: 700;
  font-family: monospace;
  line-height: 1;
}

.grade-S { border-color: #F5C842; background: rgba(245, 200, 66, 0.14); }
.grade-S .grade-text { color: #F5C842; text-shadow: 0 0 18rpx rgba(245, 200, 66, 0.9); }
.grade-A { border-color: #FF4FD8; background: rgba(255, 79, 216, 0.12); }
.grade-A .grade-text { color: #FF4FD8; }
.grade-B { border-color: #6FC8FF; background: rgba(111, 200, 255, 0.12); }
.grade-B .grade-text { color: #6FC8FF; }
.grade-C { border-color: #4CFF8A; background: rgba(76, 255, 138, 0.1); }
.grade-C .grade-text { color: #4CFF8A; }
.grade-D { border-color: #8A8AAA; background: rgba(138, 138, 170, 0.1); }
.grade-D .grade-text { color: #8A8AAA; }

.score-main {
  display: flex;
  flex-direction: column;
}

.over-score-num {
  font-size: 78rpx;
  font-weight: 700;
  color: #D97757;
  font-family: monospace;
  line-height: 1.1;
}

.over-score-label {
  font-size: 20rpx;
  color: #8A8ABA;
  font-family: monospace;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  margin-bottom: 34rpx;
  border-top: 2rpx solid #2E3A5C;
  border-left: 2rpx solid #2E3A5C;
}

.stat {
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid #2E3A5C;
  border-bottom: 2rpx solid #2E3A5C;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: monospace;
}

.stat-label {
  font-size: 18rpx;
  color: #8A8ABA;
  font-family: monospace;
}

.over-best {
  font-size: 22rpx;
  color: #C0C0E8;
  font-family: monospace;
  margin-bottom: 38rpx;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.retry-btn {
  flex: 1;
  background: #D97757;
  padding: 20rpx 0;
  text-align: center;
  user-select: none;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.retry-btn:active { opacity: 0.75; }

.retry-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A2E;
  letter-spacing: 4rpx;
  font-family: monospace;
}

.racing-share-btn {
  flex: 1;
  padding: 18rpx 0;
  background: transparent;
  border: 2rpx solid #4A6FA5;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A6FA5;
  letter-spacing: 4rpx;
  font-family: monospace;
  line-height: 1.4;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.racing-share-btn::after { border: none; }

.racing-share-btn:active { opacity: 0.75; }
