<view class="wood-page snake-container" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
  <!-- 顶部木条 -->
  <view class="wood-header stats-bar">
    <view class="stat-block">
      <text class="head-label">SCORE</text>
      <text class="head-value">{{score}}</text>
    </view>
    <view class="stat-block">
      <text class="head-label">BEST</text>
      <text class="head-value head-gold">{{bestScore}}</text>
    </view>
    <view class="stat-block">
      <text class="head-label">LENGTH</text>
      <text class="head-value">{{snakeLen}}</text>
    </view>
  </view>

  <canvas id="snake-canvas" type="2d" class="snake-canvas"></canvas>

  <!-- 开始画面 -->
  <view class="overlay" wx:if="{{gameState === 'idle'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">Clawd 贪吃蛇</text>
      </view>
      <view class="plaque-body">
        <text class="plaque-text">吃掉 BUG · 越吃越长</text>
        <text class="plaque-text">往哪滑就往哪拐,按住可连续转向</text>
        <text class="plaque-hint">金色 BUG 限时出现,+5 分</text>
        <view class="btn-col btn-col-gap">
          <view class="wbtn wbtn-primary" catchtouchstart="onStart">开始游戏</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 结束画面 -->
  <view class="overlay" wx:if="{{gameState === 'over'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">游戏结束</text>
      </view>
      <view class="plaque-body">
        <text class="score-label">{{overReason}} · 本局得分</text>
        <text class="score-num">{{score}}</text>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="cell-label">长度</text>
            <text class="cell-value">{{snakeLen}}</text>
          </view>
          <view class="stat-cell">
            <text class="cell-label">最高</text>
            <text class="cell-value">{{bestScore}}</text>
          </view>
        </view>
        <view class="btn-col">
          <view class="wbtn wbtn-primary" catchtouchstart="onRetry">再来一次</view>
          <button class="wbtn wbtn-share" open-type="share" catchtouchstart="">分享战绩</button>
        </view>
      </view>
    </view>
  </view>
</view>
