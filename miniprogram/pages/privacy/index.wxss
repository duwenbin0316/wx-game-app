page { background: #1A1A2E; }

.pv {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #1E1E38;
  border: 2rpx solid #2E3A5C;
  box-shadow: 4rpx 4rpx 0 #0E0E22;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.no {
  font-size: 22rpx;
  font-family: monospace;
  color: #1A1A2E;
  background: #D97757;
  padding: 2rpx 10rpx;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: #8A8ABA;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  gap: 20rpx;
}

.k {
  font-size: 24rpx;
  color: #8A8ABA;
  flex-shrink: 0;
}

.v {
  font-size: 24rpx;
  color: #C0C0E8;
  font-family: monospace;
  text-align: right;
}

.ok { color: #4CFF8A; }
.warn { color: #F5C842; }

.btns {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.btn {
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  color: #C0C0E8;
  background: #16162A;
  border: 2rpx solid #2E3A5C;
}

.btn:active { opacity: 0.7; }

.primary {
  color: #1A1A2E;
  background: #D97757;
  border-color: #D97757;
}

.danger {
  color: #FF6B6B;
  border-color: #6B3A4A;
}

.result {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #F5C842;
  font-family: monospace;
  word-break: break-all;
}

.hint {
  display: block;
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #5A5A8A;
  line-height: 1.5;
}

.agreement {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #16162A;
  border-left: 4rpx solid #6FC8FF;
}

.ag-h {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin: 10rpx 0 6rpx;
}

.ag-p {
  display: block;
  font-size: 23rpx;
  color: #A0A0CA;
  line-height: 1.6;
}

.log {
  margin-top: 20rpx;
  max-height: 320rpx;
  overflow-y: auto;
  background: #16162A;
  padding: 12rpx 16rpx;
}

.log-empty {
  font-size: 22rpx;
  color: #5A5A8A;
}

.log-item {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 22rpx;
  font-family: monospace;
}

.log-at { color: #5A6A9A; flex-shrink: 0; }
.log-act { color: #C0C0E8; }

.gate { margin-bottom: 16rpx; }

.granted {
  padding: 20rpx;
  background: rgba(76, 255, 138, 0.06);
  border: 2rpx solid rgba(76, 255, 138, 0.35);
}

.granted-title {
  display: block;
  font-size: 24rpx;
  color: #4CFF8A;
}

.camera {
  width: 100%;
  height: 300rpx;
  margin-top: 16rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
  border-bottom: 2rpx solid #2A2A4A;
  margin-bottom: 8rpx;
}

.sw-title {
  display: block;
  font-size: 26rpx;
  color: #FFFFFF;
}

.sw-sub {
  display: block;
  font-size: 21rpx;
  color: #6A6A9A;
  margin-top: 4rpx;
}

.switch {
  width: 88rpx;
  height: 48rpx;
  background: #2E3A5C;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s;
}

.switch-on { background: #4CC38A; }

.knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FFFFFF;
  transition: left 0.2s;
}

.switch-on .knob { left: 46rpx; }

/* 敏感信息卡片 */
.secret {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 24rpx;
  background: #16162A;
  border: 2rpx solid #3A2A5A;
}

.secret-blur .secret-row,
.secret-blur .secret-toggle {
  filter: blur(14rpx);
}

.wm {
  position: absolute;
  top: -40rpx; left: -60rpx; right: -60rpx; bottom: -40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx 60rpx;
  transform: rotate(-18deg);
  pointer-events: none;
  z-index: 1;
}

.wm-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.07);
  white-space: nowrap;
}

.secret-row {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.secret-v {
  font-size: 28rpx;
  color: #FFFFFF;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.secret-toggle {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #6FC8FF;
  text-align: right;
}

.rec-banner {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 23rpx;
  color: #1A1A2E;
  background: #F5C842;
}
