<view class="pv">
  <!-- 状态总览 -->
  <view class="card summary">
    <view class="row"><text class="k">基础库</text><text class="v">{{sdkVersion || '未知'}}</text></view>
    <view class="row"><text class="k">微信隐私授权</text><text class="v {{needAuthorization ? 'warn' : 'ok'}}">{{support.privacySetting ? (needAuthorization ? '需要授权' : '已授权 / 无需授权') : '基础库不支持'}}</text></view>
    <view class="row"><text class="k">本地同意记录</text><text class="v">{{consentText}}</text></view>
  </view>

  <!-- 1. 隐私协议 -->
  <view class="card">
    <view class="card-title"><text class="no">01</text>隐私协议</view>
    <text class="desc">打开小程序后台配置的官方隐私保护指引;页内同时提供一份可读的协议摘要。</text>
    <view class="btns">
      <view class="btn primary" bindtap="onOpenContract">查看{{contractName}}</view>
      <view class="btn" bindtap="onToggleAgreement">{{showAgreement ? '收起' : '展开'}}协议摘要</view>
    </view>
    <view class="agreement" wx:if="{{showAgreement}}">
      <text class="ag-h">一、我们收集的信息</text>
      <text class="ag-p">· 微信昵称、头像:仅在联机对战时展示给对手。</text>
      <text class="ag-p">· 游戏记录(最高分、战绩):仅保存在你的设备本地。</text>
      <text class="ag-p">· 宠物数据:与你的微信身份(OpenID)关联,保存在云端。</text>
      <text class="ag-h">二、系统权限</text>
      <text class="ag-p">· 相机、麦克风、相册:仅在你主动使用对应功能时申请,可随时在设置中关闭。</text>
      <text class="ag-h">三、你的权利</text>
      <text class="ag-p">· 你可以撤回同意、关闭权限,或删除小程序以清除本地数据。</text>
    </view>
  </view>

  <!-- 2. 隐私弹窗 -->
  <view class="card">
    <view class="card-title"><text class="no">02</text>隐私授权弹窗</view>
    <text class="desc">自定义弹窗接管微信官方弹窗(onNeedPrivacyAuthorization)。"同意"按钮使用 open-type="agreePrivacyAuthorization"。</text>
    <view class="btns">
      <view class="btn primary" bindtap="onShowPopup">模拟首次启动弹窗</view>
      <view class="btn" bindtap="onCallPrivacyApi">调用隐私接口(读剪贴板)</view>
      <view class="btn" bindtap="onRequireAuthorize">主动请求授权</view>
    </view>
    <text class="result" wx:if="{{clipboardResult}}">{{clipboardResult}}</text>
    <text class="hint">提示:在开发者工具「清除缓存 → 清除授权数据」后,调用隐私接口就会弹出。</text>
  </view>

  <!-- 3. 撤回 -->
  <view class="card">
    <view class="card-title"><text class="no">03</text>撤回同意 / 权限</view>
    <text class="desc">微信未提供撤回隐私授权的接口:这里撤回的是本小程序保存的同意记录;系统权限可在设置页关闭。</text>
    <view class="btns">
      <view class="btn danger" bindtap="onRevoke">撤回同意</view>
      <view class="btn" bindtap="onOpenSetting">打开权限设置</view>
      <view class="btn" bindtap="onClearLog">清空日志</view>
    </view>
    <view class="log">
      <text class="log-empty" wx:if="{{!log.length}}">暂无操作记录</text>
      <view class="log-item" wx:for="{{log}}" wx:key="index">
        <text class="log-at">{{item.at}}</text>
        <text class="log-act">{{item.action}}</text>
      </view>
    </view>
  </view>

  <!-- 4. 权限容器 + 权限申请弹窗 -->
  <view class="card">
    <view class="card-title"><text class="no">04</text>权限容器 · 权限申请弹窗</view>
    <text class="desc">未授权时显示用途说明;点"开启"先弹申请说明,确认后才调用系统授权;被拒过则引导去设置页。</text>
    <view class="gate">
      <permission-gate scope="scope.camera" name="相机" reason="扫码加入对战房间、拍摄头像" bind:change="onPermChange">
        <view class="granted">
          <text class="granted-title">✓ 相机已授权 · 实时预览</text>
          <camera class="camera" device-position="front" flash="off" binderror="onCameraError"></camera>
        </view>
      </permission-gate>
    </view>
    <view class="gate">
      <permission-gate scope="scope.record" name="麦克风" reason="联机对战时的语音聊天" bind:change="onPermChange">
        <view class="granted"><text class="granted-title">✓ 麦克风已授权,可以使用语音聊天</text></view>
      </permission-gate>
    </view>
    <view class="gate">
      <permission-gate scope="scope.writePhotosAlbum" name="相册" reason="保存游戏成绩分享图到相册" bind:change="onPermChange">
        <view class="granted"><text class="granted-title">✓ 相册已授权,可以保存成绩图</text></view>
      </permission-gate>
    </view>
  </view>

  <!-- 5. 防截屏 / 录屏 -->
  <view class="card">
    <view class="card-title"><text class="no">05</text>防截屏 / 防录屏</view>
    <view class="switch-row" bindtap="onToggleHideOnCapture">
      <view class="sw-text">
        <text class="sw-title">截屏 / 录屏时隐藏页面内容</text>
        <text class="sw-sub">{{support.visualEffect ? 'setVisualEffectOnCapture · 仅 Android 生效' : '当前设备/基础库不支持'}}</text>
      </view>
      <view class="switch {{hideOnCapture ? 'switch-on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="row"><text class="k">截屏检测</text><text class="v">{{support.captureScreen ? (captureCount ? '已截屏 ' + captureCount + ' 次 · ' + lastCapture : '监听中,截一张试试') : '不支持'}}</text></view>
    <view class="row"><text class="k">录屏状态</text><text class="v {{recording ? 'warn' : ''}}">{{support.recordingState ? (recording ? '正在录屏 · 敏感信息已遮挡' : '未录屏') : '基础库不支持(需 3.1.4+)'}}</text></view>

    <!-- 敏感信息卡片:默认脱敏 + 水印;录屏时整体打码 -->
    <view class="secret {{recording ? 'secret-blur' : ''}}">
      <view class="wm">
        <text class="wm-text" wx:for="{{watermarks}}" wx:key="id">{{item.text}}</text>
      </view>
      <view class="secret-row"><text class="k">手机号</text><text class="secret-v">{{phone}}</text></view>
      <view class="secret-row"><text class="k">身份证</text><text class="secret-v">{{idCard}}</text></view>
      <view class="secret-toggle" bindtap="onTogglePlain">{{showPlain ? '隐藏' : '查看完整信息'}}</view>
    </view>
    <view class="rec-banner" wx:if="{{recording}}">检测到录屏,敏感内容已自动遮挡</view>
  </view>

  <privacy-popup id="privacy-popup" bind:agree="onPopupAgree" bind:disagree="onPopupDisagree"></privacy-popup>
</view>
