<view class="container">
  <view class="game-header">
    <view class="header-top">
      <view class="header-slot header-left">
        <text class="mode-pill">{{mode === 'online' ? (myColor === 'black' ? '你是：黑棋' : '你是：白棋') : (isAiMode ? '人机对战' : '本地对战')}}</text>
      </view>
      <view class="header-slot header-right">
        <text class="status-text {{winner ? 'finished' : (mode === 'online' ? (canPlay ? 'your-turn' : 'waiting') : (isAiMode ? (currentPlayer === 'black' ? 'your-turn' : 'waiting') : ''))}}">{{mode === 'online' ? (winner ? '对局结束' : (canPlay ? '轮到你了' : '等待对手下棋...')) : (isAiMode ? (winner ? '对局结束' : (currentPlayer === 'black' ? '你的回合' : '电脑思考中...')) : '自由对弈')}}</text>
      </view>
    </view>

    <view class="players-row">
      <!-- 小新 / 黑棋 -->
      <view class="player-slot {{currentPlayer === 'black' ? 'active' : 'inactive'}}">
        <view class="char-frame {{currentPlayer === 'black' ? 'char-active' : ''}}">
          <image class="char-img" src="/images/shinnosuke.png" mode="aspectFit"/>
        </view>
        <text class="player-name">{{blackName}}</text>
      </view>

      <!-- 中间：棋子 + VS -->
      <view class="vs-block">
        <view class="pieces-row">
          <view class="chess-piece black {{currentPlayer === 'black' ? 'active' : ''}}"></view>
          <text class="vs-text">VS</text>
          <view class="chess-piece white {{currentPlayer === 'white' ? 'active' : ''}}"></view>
        </view>
        <text class="move-count">第 {{(mode === 'online' ? (roomInfo.moveHistory.length || 0) : moveHistory.length) + (winner ? 0 : 1)}} 手</text>
      </view>

      <!-- 左卫门 / 白棋 -->
      <view class="player-slot {{currentPlayer === 'white' ? 'active' : 'inactive'}}">
        <view class="char-frame {{currentPlayer === 'white' ? 'char-active' : ''}}">
          <image class="char-img" src="/images/boo.png" mode="aspectFit"/>
        </view>
        <text class="player-name">{{whiteName}}</text>
      </view>
    </view>
  </view>

  <!-- 棋盘:Canvas 绘制(木纹、棋子、落子动画、连五金线) -->
  <view class="game-board {{isFlipping ? 'flipping' : ''}}">
    <canvas type="2d" id="board-canvas" class="board-canvas" bindtouchend="onBoardTouch"></canvas>
  </view>

  <view class="board-bar">
    <text class="board-tip {{ghostTip ? 'tip-on' : ''}}">{{reviewMode ? '复盘中 · 第 ' + reviewStep + ' / ' + reviewTotal + ' 手' : (ghostTip || (confirmMode ? '点选位置,再点一次落子' : '点击交叉点落子'))}}</text>
    <view class="toggle-row">
      <view class="toggle {{confirmMode ? 'toggle-on' : ''}}" bindtap="onToggleConfirm">落子确认</view>
      <view class="toggle {{showNumbers ? 'toggle-on' : ''}}" bindtap="onToggleNumbers">手数</view>
    </view>
  </view>

  <!-- 复盘控制条 -->
  <view class="review-bar" wx:if="{{reviewMode}}">
    <view class="rv-btn" data-act="first" bindtap="onReviewStep">|◀</view>
    <view class="rv-btn" data-act="prev" bindtap="onReviewStep">◀</view>
    <text class="rv-step">{{reviewStep}} / {{reviewTotal}}</text>
    <view class="rv-btn" data-act="next" bindtap="onReviewStep">▶</view>
    <view class="rv-btn" data-act="last" bindtap="onReviewStep">▶|</view>
    <view class="rv-exit" bindtap="onReviewExit">退出</view>
  </view>

  <view class="game-controls" wx:else>
    <view wx:if="{{mode === 'online'}}" class="leave-btn" bindtap="onLeaveRoom">离开</view>
    <view class="undo-btn {{canUndo ? '' : 'disabled'}}" bindtap="onUndo">
      悔棋<text wx:if="{{mode === 'online'}}">({{undoLeft}})</text>
    </view>
    <view wx:if="{{mode !== 'online'}}" class="hint-btn {{hintLeft > 0 && !winner ? '' : 'disabled'}}" bindtap="onHint">提示({{hintLeft}})</view>
    <view class="flip-btn" bindtap="onFlipTable">掀桌</view>
    <view class="restart-btn" bindtap="onRestart">重开</view>
  </view>

  <!-- 掀桌横幅 -->
  <view class="flip-banner" wx:if="{{isFlipping}}">(╯°□°)╯︵ ┻━┻</view>

  <!-- 结果覆盖层 -->
  <view class="result-mask" wx:if="{{showResult}}">
    <view class="result-card">
      <view class="result-icon">{{resultIcon ? resultIcon : (resultIsWin ? '🏆' : '🎯')}}</view>
      <text class="result-title">{{resultTitle}}</text>
      <text class="result-sub">{{resultSub}}</text>
      <view class="result-actions">
        <view class="result-btn result-restart" bindtap="onResultRestart">再来一局</view>
        <view wx:if="{{canReview}}" class="result-btn result-review" bindtap="onReview">复盘</view>
        <view class="result-btn result-leave" bindtap="onResultLeave">返回大厅</view>
      </view>
    </view>
  </view>
</view>
