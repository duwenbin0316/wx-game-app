<view class="wood-bg container">
  <view class="wood-plate game-header">
    <view class="header-top">
      <view class="header-slot header-left">
        <text class="mode-pill">{{mode === 'online' ? (myColor === 'black' ? '你是：黑棋' : '你是：白棋') : (isAiMode ? '人机对战' : '本地对战')}}</text>
      </view>
      <view class="header-slot header-right">
        <text class="status-text {{winner ? 'finished' : (mode === 'online' ? (canPlay ? 'your-turn' : 'waiting') : (isAiMode ? (currentPlayer === 'black' ? 'your-turn' : 'waiting') : ''))}}">{{mode === 'online' ? (winner ? '对局结束' : (canPlay ? '轮到你了' : '等待对手下棋...')) : (isAiMode ? (winner ? '对局结束' : (currentPlayer === 'black' ? '你的回合' : '电脑思考中...')) : '自由对弈')}}</text>
      </view>
    </view>

    <view class="players-row">
      <!-- 小新 / 黑棋 -->
      <view class="player-slot {{currentPlayer === 'black' ? 'active' : 'inactive'}}">
        <view class="char-frame {{currentPlayer === 'black' ? 'char-active' : ''}}">
          <image class="char-img" src="/images/shinnosuke.png" mode="aspectFit"/>
        </view>
        <text class="player-name">{{blackName}}</text>
      </view>

      <!-- 中间：棋子 + VS -->
      <view class="vs-block">
        <view class="pieces-row">
          <view class="chess-piece black {{currentPlayer === 'black' ? 'active' : ''}}"></view>
          <text class="vs-text">VS</text>
          <view class="chess-piece white {{currentPlayer === 'white' ? 'active' : ''}}"></view>
        </view>
        <text class="move-count">第 {{(mode === 'online' ? (roomInfo.moveHistory.length || 0) : moveHistory.length) + (winner ? 0 : 1)}} 手</text>
      </view>

      <!-- 左卫门 / 白棋 -->
      <view class="player-slot {{currentPlayer === 'white' ? 'active' : 'inactive'}}">
        <view class="char-frame {{currentPlayer === 'white' ? 'char-active' : ''}}">
          <image class="char-img" src="/images/boo.png" mode="aspectFit"/>
        </view>
        <text class="player-name">{{whiteName}}</text>
      </view>
    </view>
  </view>

  <!-- 棋盘:Canvas 绘制(木纹、棋子、落子动画、连五金线) -->
  <view class="game-board {{isFlipping ? 'flipping' : ''}}">
    <canvas type="2d" id="board-canvas" class="board-canvas"
            bindtouchstart="onBoardTouchStart"
            catchtouchmove="onBoardTouchMove"
            bindtouchend="onBoardTouchEnd"
            bindtouchcancel="onBoardTouchCancel"></canvas>
  </view>

  <!-- 有预落子时:大号"落子"/"取消",不用再去点那个小小的交叉点 -->
  <view class="board-bar ghost-bar" wx:if="{{ghostLabel && !reviewMode}}">
    <view class="wood-key ghost-cancel" bindtap="onGhostCancel">取消</view>
    <view class="wood-key wood-key-red ghost-confirm" bindtap="onGhostConfirm">落子 {{ghostLabel}}</view>
  </view>
  <view class="board-bar" wx:else>
    <text class="board-tip {{ghostTip ? 'tip-on' : ''}}">{{reviewMode ? '复盘中 · 第 ' + reviewStep + ' / ' + reviewTotal + ' 手' : (ghostTip || (confirmMode ? '按住拖动瞄准,松手预览' : '按住拖动瞄准,松手落子'))}}</text>
    <view class="toggle-row">
      <view class="wood-key toggle {{confirmMode ? 'toggle-on' : ''}}" bindtap="onToggleConfirm">落子确认</view>
      <view class="wood-key toggle {{showNumbers ? 'toggle-on' : ''}}" bindtap="onToggleNumbers">手数</view>
    </view>
  </view>

  <!-- 复盘控制条 -->
  <view class="review-bar" wx:if="{{reviewMode}}">
    <view class="wood-key rv-btn" data-act="first" bindtap="onReviewStep">|◀</view>
    <view class="wood-key rv-btn" data-act="prev" bindtap="onReviewStep">◀</view>
    <text class="rv-step">{{reviewStep}} / {{reviewTotal}}</text>
    <view class="wood-key rv-btn" data-act="next" bindtap="onReviewStep">▶</view>
    <view class="wood-key rv-btn" data-act="last" bindtap="onReviewStep">▶|</view>
    <view class="wood-key wood-key-red rv-btn" bindtap="onReviewExit">退出</view>
  </view>

  <view class="game-controls" wx:else>
    <view wx:if="{{mode === 'online'}}" class="wood-key ctrl-btn" bindtap="onLeaveRoom">离开</view>
    <view class="wood-key ctrl-btn {{canUndo ? '' : 'wood-key-disabled'}}" bindtap="onUndo">
      悔棋<text wx:if="{{mode === 'online'}}">({{undoLeft}})</text>
    </view>
    <view wx:if="{{mode !== 'online'}}" class="wood-key ctrl-btn hint-btn {{hintLeft > 0 && !winner ? '' : 'wood-key-disabled'}}" bindtap="onHint">提示({{hintLeft}})</view>
    <view class="wood-key ctrl-btn flip-btn" bindtap="onFlipTable">掀桌</view>
    <view class="wood-key wood-key-red ctrl-btn" bindtap="onRestart">重开</view>
  </view>

  <!-- 掀桌横幅 -->
  <view class="flip-banner" wx:if="{{isFlipping}}">(╯°□°)╯︵ ┻━┻</view>

  <!-- 结果覆盖层 -->
  <view class="overlay result-mask" wx:if="{{showResult}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">{{resultIsWin ? '胜利' : '对局结束'}}</text>
      </view>
      <view class="plaque-body">
        <view class="result-icon">{{resultIcon ? resultIcon : (resultIsWin ? '🏆' : '🎯')}}</view>
        <text class="result-title">{{resultTitle}}</text>
        <text class="plaque-hint">{{resultSub}}</text>
        <view class="btn-col btn-col-gap">
          <view class="wbtn wbtn-primary" bindtap="onResultRestart">再来一局</view>
          <view wx:if="{{canReview}}" class="wbtn" bindtap="onReview">复盘</view>
          <view class="wbtn" bindtap="onResultLeave">返回大厅</view>
        </view>
      </view>
    </view>
  </view>
</view>
