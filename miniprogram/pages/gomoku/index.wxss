page {
  background: #1A1A2E;
}

.container {
  padding: 16rpx 20rpx 32rpx;
  background: #1A1A2E;
  min-height: 100vh;
  box-sizing: border-box;
  width: 100%;
}

/* ── 顶部信息栏 ── */
.game-header {
  background: #1E1E38;
  border: 2rpx solid #2E3A5C;
  border-radius: 0;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 4rpx 4rpx 0 #0E0E22;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 44rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #2A2A4A;
}

.header-slot {
  flex: 1 1 0;
  display: flex;
  align-items: center;
}

.header-left  { justify-content: flex-start; }
.header-right { justify-content: flex-end; }

.mode-pill {
  padding: 6rpx 18rpx;
  border-radius: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #A78BFA;
  background: rgba(167, 139, 250, 0.1);
  border: 1rpx solid #3A2A5A;
  letter-spacing: 1rpx;
  font-family: monospace;
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: #3A3A6A;
  font-family: monospace;
}

.status-text.waiting   { color: #4A6FA5; }
.status-text.your-turn { color: #D97757; }
.status-text.finished  { color: #6A6A9A; }

/* ── 玩家行 ── */
.players-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 14rpx;
}

.player-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 120rpx;
}

.player-slot.active   { opacity: 1; }
.player-slot.inactive { opacity: 0.35; filter: grayscale(30%); }

.char-frame {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.char-img {
  width: 108rpx;
  height: 108rpx;
}

.char-active {
  filter: drop-shadow(0 0 6rpx rgba(217,119,87,0.9));
}

.player-name {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  font-family: monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 116rpx;
  text-align: center;
}

.player-slot.active   .player-name { color: #D97757; }
.player-slot.inactive .player-name { color: #4A6FA5; }

.vs-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  flex-shrink: 0;
}

.pieces-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.chess-piece {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.chess-piece.black {
  background: radial-gradient(circle at 35% 35%, #5b6470, #111827);
  border: 2rpx solid #9ca3af;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.5);
}

.chess-piece.black.active {
  border-color: #D97757;
  box-shadow: 0 0 0 4rpx rgba(217,119,87,0.3), 0 2rpx 6rpx rgba(0,0,0,0.5);
}

.chess-piece.white {
  background: radial-gradient(circle at 35% 35%, #ffffff, #ddd);
  border: 2rpx solid #aaa;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.3);
}

.chess-piece.white.active {
  border-color: #A78BFA;
  box-shadow: 0 0 0 4rpx rgba(167,139,250,0.3), 0 2rpx 6rpx rgba(0,0,0,0.3);
}

.move-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A8ABA;
  font-family: monospace;
}

.vs-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #3A3A6A;
  letter-spacing: 3rpx;
  font-family: monospace;
}

/* ── 棋盘:木框 + canvas ── */
.game-board {
  background: linear-gradient(135deg, #5A3A22 0%, #3E2716 100%);
  border: 2rpx solid #7A5230;
  padding: 12rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.55), 6rpx 6rpx 0 #0A0A1A, inset 0 0 0 2rpx rgba(255, 220, 160, 0.12);
  margin-bottom: 14rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.board-canvas {
  /* container 左右各 20rpx + 木框左右各 14rpx */
  width: calc(100vw - 68rpx);
  height: calc(100vw - 68rpx);
  display: block;
}

.board-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  min-height: 52rpx;
}

.board-tip {
  flex: 1;
  font-size: 22rpx;
  color: #6A6A9A;
  font-family: monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.board-tip.tip-on { color: #D97757; }

.toggle-row {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.toggle {
  font-size: 20rpx;
  font-family: monospace;
  padding: 8rpx 16rpx;
  color: #4A6FA5;
  background: #16162A;
  border: 2rpx solid #2E3A5C;
}

.toggle-on {
  color: #1A1A2E;
  background: #A78BFA;
  border-color: #A78BFA;
}

/* ── 复盘控制条 ── */
.review-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.rv-btn, .rv-exit {
  font-size: 26rpx;
  font-weight: 700;
  font-family: monospace;
  padding: 16rpx 22rpx;
  background: #1E1E38;
  color: #C0C0E8;
  border: 2rpx solid #2E3A5C;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.rv-btn:active, .rv-exit:active { opacity: 0.7; }

.rv-step {
  min-width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  font-family: monospace;
  color: #F5C842;
}

.rv-exit {
  color: #1A1A2E;
  background: #D97757;
  border-color: #D97757;
}

/* ── 底部按钮 ── */
.game-controls {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.restart-btn, .leave-btn, .undo-btn, .hint-btn {
  border-radius: 0;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 26rpx;
  user-select: none;
  letter-spacing: 1rpx;
  font-family: monospace;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.hint-btn {
  background: #1E1E38;
  color: #4CC38A;
  border: 2rpx solid #2A5A44;
}

.hint-btn:active { opacity: 0.75; }

.hint-btn.disabled {
  background: #16162A;
  color: #2A4A3A;
  border-color: #1E1E38;
  box-shadow: none;
}

.restart-btn {
  background: #D97757;
  color: #1A1A2E;
}

.restart-btn:active { opacity: 0.75; }

.flip-btn {
  border-radius: 0;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 26rpx;
  user-select: none;
  letter-spacing: 1rpx;
  font-family: monospace;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
  background: #1E1E38;
  color: #FF6B6B;
  border: 2rpx solid #6B3A4A;
}

.flip-btn:active { opacity: 0.75; }

/* ── 掀桌动画 ── */
.game-board.flipping {
  animation: table-flip 1.1s cubic-bezier(0.5, -0.2, 0.9, 0.6) forwards;
  pointer-events: none;
}

@keyframes table-flip {
  0%   { transform: none; opacity: 1; }
  15%  { transform: translateY(10rpx) rotate(2deg); }
  35%  { transform: translateY(-80rpx) rotate(-10deg); }
  100% { transform: translateY(-1800rpx) rotate(-500deg) scale(0.7); opacity: 0; }
}

.flip-banner {
  position: fixed;
  left: 0; right: 0;
  top: 38%;
  text-align: center;
  font-size: 60rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: monospace;
  text-shadow: 4rpx 4rpx 0 #0E0E22;
  z-index: 90;
  pointer-events: none;
  animation: flip-banner-pop 1.1s ease-out forwards;
}

@keyframes flip-banner-pop {
  0%   { opacity: 0; transform: scale(0.3) rotate(-8deg); }
  25%  { opacity: 1; transform: scale(1.15) rotate(3deg); }
  40%  { transform: scale(1) rotate(0deg); }
  85%  { opacity: 1; }
  100% { opacity: 0; transform: scale(1) translateY(-30rpx); }
}

.undo-btn {
  background: #1E1E38;
  color: #4A6FA5;
  border: 2rpx solid #2E3A5C;
}

.undo-btn:active { opacity: 0.75; }

.undo-btn.disabled {
  background: #16162A;
  color: #2A2A4A;
  border-color: #1E1E38;
  box-shadow: none;
}

.leave-btn {
  background: #1E1E38;
  color: #A78BFA;
  border: 2rpx solid #3A2A5A;
}

.leave-btn:active { opacity: 0.75; }

/* ── 结果覆盖层（居中弹出）── */
.result-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(10, 10, 30, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.result-card {
  width: 100%;
  max-width: 560rpx;
  background: rgba(30, 30, 60, 0.97);
  border: 2rpx solid #4A6FA5;
  border-radius: 0;
  padding: 56rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 6rpx 6rpx 0 #0E0E22, 0 0 40rpx rgba(74,111,165,0.3);
}

.result-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.result-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  margin-bottom: 14rpx;
  font-family: monospace;
}

.result-sub {
  font-size: 22rpx;
  color: #4A6FA5;
  letter-spacing: 2rpx;
  margin-bottom: 48rpx;
  font-family: monospace;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  user-select: none;
  font-family: monospace;
  box-shadow: 3rpx 3rpx 0 #0E0E22;
}

.result-btn:active { opacity: 0.75; }

.result-restart {
  background: #D97757;
  color: #1A1A2E;
}

.result-review {
  background: #1E1E38;
  color: #F5C842;
  border: 2rpx solid #6A5A2A;
}

.result-leave {
  background: #1E1E38;
  color: #4A6FA5;
  border: 2rpx solid #2E3A5C;
}
