/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放五子棋自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.container {
  padding: 16rpx 20rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  width: 100%;
}

/* ── 顶部信息栏:一块小木牌 ── */
.game-header {
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
  width: 100%;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 44rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid rgba(60, 30, 10, 0.45);
  box-shadow: 0 2rpx 0 rgba(255, 230, 190, 0.18);
}

.header-slot {
  flex: 1 1 0;
  display: flex;
  align-items: center;
}

.header-left  { justify-content: flex-start; }
.header-right { justify-content: flex-end; }

/* 凹进木牌里的小标签 */
.mode-pill {
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF0D6;
  background: rgba(50, 24, 6, 0.35);
  box-shadow: inset 0 2rpx 5rpx rgba(20, 8, 0, 0.5), 0 2rpx 0 rgba(255, 230, 190, 0.2);
  letter-spacing: 1rpx;
  font-family: monospace;
}

.status-text {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #F6DDB0;
  font-family: monospace;
  text-shadow: 0 2rpx 0 rgba(50, 25, 8, 0.6);
}

.status-text.waiting   { color: #F6DDB0; }
.status-text.your-turn { color: #FFD46A; }
.status-text.finished  { color: #E2C49A; }

/* ── 玩家行 ── */
.players-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 14rpx;
}

.player-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 120rpx;
}

.player-slot.active   { opacity: 1; }
.player-slot.inactive { opacity: 0.45; filter: grayscale(30%); }

.char-frame {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.char-img {
  width: 108rpx;
  height: 108rpx;
}

.char-active {
  filter: drop-shadow(0 0 8rpx rgba(255, 210, 110, 0.9));
}

.player-name {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-family: monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 116rpx;
  text-align: center;
  text-shadow: 0 2rpx 0 rgba(50, 25, 8, 0.6);
}

.player-slot.active   .player-name { color: #FFD46A; }
.player-slot.inactive .player-name { color: #F6DDB0; }

.vs-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  flex-shrink: 0;
}

.pieces-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.chess-piece {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.chess-piece.black {
  background: radial-gradient(circle at 35% 35%, #5b6470, #111827);
  border: 2rpx solid #3A200E;
  box-shadow: 0 3rpx 5rpx rgba(0, 0, 0, 0.5);
}

.chess-piece.black.active {
  border-color: #FFD46A;
  box-shadow: 0 0 0 4rpx rgba(255, 212, 106, 0.35), 0 3rpx 5rpx rgba(0, 0, 0, 0.5);
}

.chess-piece.white {
  background: radial-gradient(circle at 35% 35%, #ffffff, #ddd);
  border: 2rpx solid #7A5230;
  box-shadow: 0 3rpx 5rpx rgba(0, 0, 0, 0.35);
}

.chess-piece.white.active {
  border-color: #FFD46A;
  box-shadow: 0 0 0 4rpx rgba(255, 212, 106, 0.35), 0 3rpx 5rpx rgba(0, 0, 0, 0.35);
}

.move-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFF0D6;
  font-family: monospace;
  text-shadow: 0 2rpx 0 rgba(50, 25, 8, 0.6);
}

.vs-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #F6DDB0;
  letter-spacing: 3rpx;
  font-family: monospace;
}

/* ── 棋盘:胡桃木厚边框 + 四角铜钉 + canvas ── */
.game-board {
  position: relative;
  border-radius: 18rpx;
  background-color: #6E4222;
  background-image:
    repeating-linear-gradient(90deg, rgba(40, 18, 4, 0.18) 0, rgba(40, 18, 4, 0.18) 2rpx, transparent 2rpx, transparent 11rpx),
    linear-gradient(135deg, #8A5530 0%, #6A3E1F 55%, #55301A 100%);
  border: 2rpx solid #3A200E;
  padding: 12rpx;
  box-shadow:
    0 10rpx 0 #3A1F0C,
    0 22rpx 40rpx rgba(0, 0, 0, 0.6),
    inset 0 3rpx 0 rgba(255, 228, 185, 0.4),
    inset 0 -3rpx 0 rgba(30, 12, 0, 0.4);
  margin-bottom: 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 四颗钉:上下两个伪元素各画左右两颗 */
.game-board::before,
.game-board::after {
  content: '';
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  height: 10rpx;
  background:
    radial-gradient(circle at 5rpx 5rpx, #FFF1C2 0, #D9A93F 2rpx, #7A5212 5rpx, transparent 5.5rpx) left center / 10rpx 10rpx no-repeat,
    radial-gradient(circle at 5rpx 5rpx, #FFF1C2 0, #D9A93F 2rpx, #7A5212 5rpx, transparent 5.5rpx) right center / 10rpx 10rpx no-repeat;
  pointer-events: none;
}

.game-board::before { top: 2rpx; }
.game-board::after  { bottom: 2rpx; }

.board-canvas {
  /* container 左右各 20rpx + 木框左右各 14rpx */
  width: calc(100vw - 68rpx);
  height: calc(100vw - 68rpx);
  display: block;
}

.board-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 26rpx;
  min-height: 96rpx;   /* 和"落子"按钮一样高,切换时下面的按钮不跳 */
}

/* 预落子确认条:取消 + 大号落子 */
.ghost-bar {
  gap: 20rpx;
}

.ghost-cancel {
  width: 200rpx;
  height: 88rpx;
  font-size: 30rpx;
}

.ghost-confirm {
  flex: 1;
  height: 88rpx;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.board-tip {
  flex: 1;
  font-size: 22rpx;
  color: #E9C48C;
  font-family: monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 -2rpx 0 rgba(0, 0, 0, 0.6);
}

.board-tip.tip-on { color: #FFD46A; }

.toggle-row {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.toggle {
  height: 68rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 0 #5A3218, 0 8rpx 10rpx rgba(0, 0, 0, 0.35), inset 0 2rpx 0 rgba(255, 244, 220, 0.6);
  transform: translateY(-3rpx);
}

/* 打开的开关:金色,按下去的样子 */
.toggle-on {
  background: linear-gradient(180deg, #FFE18A 0%, #E0A93E 100%);
  border-color: #7A5212;
  color: #5A3A08;
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 0 #7A5212, inset 0 3rpx 5rpx rgba(120, 70, 10, 0.4);
}

/* ── 复盘控制条 ── */
.review-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.rv-btn {
  height: 92rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-family: monospace;
}

.rv-step {
  min-width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  font-family: monospace;
  color: #FFD46A;
  text-shadow: 0 2rpx 0 #4A2810;
}

/* ── 底部按钮 ── */
.game-controls {
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.ctrl-btn {
  height: 96rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  font-family: monospace;
}

.hint-btn { color: #2F5A1E; }

.flip-btn { color: #8A2414; }

/* ── 掀桌动画 ── */
.game-board.flipping {
  animation: table-flip 1.1s cubic-bezier(0.5, -0.2, 0.9, 0.6) forwards;
  pointer-events: none;
}

@keyframes table-flip {
  0%   { transform: none; opacity: 1; }
  15%  { transform: translateY(10rpx) rotate(2deg); }
  35%  { transform: translateY(-80rpx) rotate(-10deg); }
  100% { transform: translateY(-1800rpx) rotate(-500deg) scale(0.7); opacity: 0; }
}

.flip-banner {
  position: fixed;
  left: 0; right: 0;
  top: 38%;
  text-align: center;
  font-size: 60rpx;
  font-weight: 700;
  color: #FFF0D6;
  font-family: monospace;
  text-shadow: 4rpx 4rpx 0 #2A1408;
  z-index: 90;
  pointer-events: none;
  animation: flip-banner-pop 1.1s ease-out forwards;
}

@keyframes flip-banner-pop {
  0%   { opacity: 0; transform: scale(0.3) rotate(-8deg); }
  25%  { opacity: 1; transform: scale(1.15) rotate(3deg); }
  40%  { transform: scale(1) rotate(0deg); }
  85%  { opacity: 1; }
  100% { opacity: 0; transform: scale(1) translateY(-30rpx); }
}

/* ── 结果弹窗 ── */
.result-mask {
  z-index: 100;
}

.result-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.result-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFD96E;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  font-family: monospace;
  text-shadow: 0 4rpx 0 #4A2810;
}
