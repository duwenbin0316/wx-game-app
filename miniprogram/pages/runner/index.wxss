/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放跑酷自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.runner-container {
  overflow: hidden;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 开始画面压暗得轻一点,让后面的木头布景透出来 */
.overlay-light {
  background: rgba(14, 7, 2, 0.45);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
