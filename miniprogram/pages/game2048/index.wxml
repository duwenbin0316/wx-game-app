<view class="wood-page g2048-container" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
  <!-- 顶部木条:分数 / 最高 / 最大块 + 重开 -->
  <view class="wood-header stats-bar">
    <view class="stat-block">
      <text class="head-label">SCORE</text>
      <text class="head-value">{{score}}</text>
    </view>
    <view class="stat-block">
      <text class="head-label">BEST</text>
      <text class="head-value head-gold">{{bestScore}}</text>
    </view>
    <view class="stat-block">
      <text class="head-label">MAX</text>
      <text class="head-value">{{maxTile}}</text>
    </view>
    <view class="wood-knob restart-btn" catchtap="onRestartTap">↻</view>
  </view>

  <canvas id="game-canvas" type="2d" class="game-canvas"></canvas>

  <!-- 开始画面 -->
  <view class="overlay" wx:if="{{gameState === 'idle'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">2048</text>
      </view>
      <view class="plaque-body">
        <text class="plaque-text">往任意方向滑动</text>
        <text class="plaque-text">相同数字的木块撞在一起就合并</text>
        <text class="plaque-hint">拼出 2048 就算通关,还能继续冲更高</text>
        <view class="btn-col btn-col-gap">
          <view class="wbtn wbtn-primary" catchtouchstart="onStart">开始游戏</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 通关画面 -->
  <view class="overlay" wx:if="{{gameState === 'win'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">2048!</text>
      </view>
      <view class="plaque-body">
        <view class="newbest-badge">
          <text class="newbest-text">你拼出来了</text>
        </view>
        <text class="score-num">{{score}}</text>
        <view class="btn-col btn-col-gap">
          <view class="wbtn wbtn-primary" catchtouchstart="onContinue">继续冲</view>
          <button class="wbtn wbtn-share" open-type="share" catchtouchstart="">分享战绩</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 结束画面 -->
  <view class="overlay" wx:if="{{gameState === 'over'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">游戏结束</text>
      </view>
      <view class="plaque-body">
        <text class="score-label">格子满了 · 本局得分</text>
        <text class="score-num">{{score}}</text>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="cell-label">最大块</text>
            <text class="cell-value">{{maxTile}}</text>
          </view>
          <view class="stat-cell">
            <text class="cell-label">最高分</text>
            <text class="cell-value">{{bestScore}}</text>
          </view>
        </view>
        <view class="btn-col">
          <view class="wbtn wbtn-primary" catchtouchstart="onRetry">再来一次</view>
          <button class="wbtn wbtn-share" open-type="share" catchtouchstart="">分享战绩</button>
        </view>
      </view>
    </view>
  </view>
</view>
