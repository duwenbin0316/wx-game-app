/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放 2048 自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.g2048-container {
  overflow: hidden;
}

/* ── 计分栏 ── */
.stats-bar {
  justify-content: space-around;
  padding: 16rpx 40rpx 18rpx;
}

.stat-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.restart-btn {
  font-size: 40rpx;
}

/* ── 画布 ── */
.game-canvas {
  flex: 1;
  width: 100%;
  display: block;
}
