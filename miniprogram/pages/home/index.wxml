<view class="wood-bg home-container">
  <!-- Logo:木圆牌上的 Clawd -->
  <view class="header">
    <canvas id="logo-canvas" type="2d" class="logo-canvas"></canvas>
    <text class="title">GAME HUB</text>
    <text class="subtitle">木头游戏大厅</text>
  </view>

  <!-- 游戏列表:一块块木牌 -->
  <view class="game-list">
    <view
      wx:for="{{games}}"
      wx:key="id"
      class="game-card"
      data-url="{{item.url}}"
      bindtap="onTapGame"
    >
      <view class="game-badge">
        <text class="game-icon">{{item.icon}}</text>
      </view>
      <view class="game-card-main">
        <text class="game-name">{{item.name}}</text>
        <text class="game-desc">{{item.desc}}</text>
      </view>
      <text class="game-arrow">›</text>
    </view>
  </view>
</view>
