/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放大厅自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.home-container {
  padding: 0 32rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── Logo 区域 ── */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 44rpx;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.45);
  box-shadow: 0 2rpx 0 rgba(255, 220, 170, 0.1);
}

.logo-canvas {
  width: 220rpx;
  height: 220rpx;
  display: block;
  margin-bottom: 24rpx;
}

/* 烫金刻字 */
.title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #FFD46A;
  letter-spacing: 12rpx;
  padding-left: 12rpx;
  font-family: monospace;
  margin-bottom: 10rpx;
  text-shadow: 0 4rpx 0 #4A2810, 0 0 18rpx rgba(255, 200, 90, 0.3);
}

.subtitle {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #E9C48C;
  letter-spacing: 6rpx;
  padding-left: 6rpx;
  font-family: monospace;
  text-shadow: 0 -2rpx 0 rgba(0, 0, 0, 0.65);
}

/* ── 游戏列表 ── */
.game-list {
  width: 100%;
}

/* ── 游戏卡片:木牌,按下去会沉一下 ── */
.game-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 26rpx;
  margin-bottom: 28rpx;
  border-radius: 20rpx;
  background-color: #8A5530;
  background-image:
    repeating-linear-gradient(180deg, rgba(60, 30, 10, 0.16) 0, rgba(60, 30, 10, 0.16) 2rpx, transparent 2rpx, transparent 9rpx, rgba(255, 225, 180, 0.05) 9rpx, rgba(255, 225, 180, 0.05) 11rpx, transparent 11rpx, transparent 19rpx),
    linear-gradient(160deg, #B07A48 0%, #8E5A31 60%, #774623 100%);
  border: 2rpx solid #4A2810;
  box-shadow: 0 10rpx 0 #3A1F0C, 0 16rpx 22rpx rgba(0, 0, 0, 0.45), inset 0 3rpx 0 rgba(255, 236, 205, 0.45);
  box-sizing: border-box;
}

.game-card:active {
  transform: translateY(8rpx);
  box-shadow: 0 2rpx 0 #3A1F0C, 0 4rpx 8rpx rgba(0, 0, 0, 0.4), inset 0 3rpx 6rpx rgba(60, 30, 10, 0.4);
}

/* 左侧圆木徽章 */
.game-badge {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 35% 30%, #F2DDB2 0%, #D4A86E 60%, #A8763F 100%);
  border: 2rpx solid #5A3218;
  box-shadow: 0 5rpx 0 #4A2810, inset 0 -4rpx 8rpx rgba(90, 50, 20, 0.35), inset 0 3rpx 0 rgba(255, 250, 235, 0.6);
}

.game-icon {
  font-size: 46rpx;
  line-height: 1;
}

.game-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.game-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF1D6;
  letter-spacing: 2rpx;
  font-family: monospace;
  text-shadow: 0 3rpx 0 #4A2810;
}

.game-desc {
  font-size: 22rpx;
  color: #F6DDB0;
  letter-spacing: 1rpx;
  font-family: monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-arrow {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFD46A;
  line-height: 1;
  text-shadow: 0 3rpx 0 #4A2810;
}
