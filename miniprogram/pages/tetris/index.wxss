/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放俄罗斯方块自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.header-left {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 140rpx;
}

.header-lv-num {
  font-size: 42rpx;
  font-weight: 700;
  font-family: monospace;
}

.header-lv-label {
  font-size: 22rpx;
  color: #F3D3A0;
  font-family: monospace;
  text-shadow: 0 2rpx 0 rgba(50, 25, 8, 0.7);
}

.header-center {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pause-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 2rpx;
  background: #4A2810;
  box-shadow: 0 2rpx 0 rgba(255, 235, 200, 0.45);
}

.mute-icon { font-size: 36rpx; }

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 140rpx;
}

/* ── 主区域 ── */
.main-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  min-height: 0;
  padding: 12rpx 12rpx 0;
  gap: 10rpx;
}

.board-wrap {
  flex: 1;
  min-width: 0;
}

.board-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.side-panel {
  width: 168rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 12rpx;
}

.side-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hold-canvas {
  width: 150rpx;
  height: 130rpx;
  display: block;
  border-radius: 12rpx;
  box-shadow: 0 0 0 4rpx #6E4222, 0 0 0 6rpx #3A200E, 0 8rpx 14rpx rgba(0, 0, 0, 0.5);
  margin-left: 6rpx;
}

.next-canvas {
  width: 150rpx;
  height: 340rpx;
  display: block;
  border-radius: 12rpx;
  box-shadow: 0 0 0 4rpx #6E4222, 0 0 0 6rpx #3A200E, 0 8rpx 14rpx rgba(0, 0, 0, 0.5);
  margin-left: 6rpx;
}

/* 统计:一块小木牌 */
.stats {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 10rpx 0 0 4rpx;
  padding: 14rpx 16rpx;
}

.stat-row {
  display: flex;
  flex-direction: column;
}

/* ── 操作区:木质控制台 ── */
.controls {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 22rpx 28rpx 44rpx;
}

.controls-hidden { visibility: hidden; }

.ctrl-cluster {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.ctrl-row {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
}

.cbtn {
  width: 156rpx;
  height: 104rpx;
}

.cbtn-wide { width: 326rpx; }

.rot-glyph {
  font-size: 44rpx;
  font-weight: 700;
  color: #5A3216;
  font-family: monospace;
  line-height: 1;
  text-shadow: 0 2rpx 0 rgba(255, 238, 210, 0.55);
}

.rot-main {
  font-size: 52rpx;
  color: #3E1E08;
}

.drop-glyph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.drop-arr { border-top-color: #FFEBD2; }

.drop-bar {
  width: 36rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: #FFEBD2;
}

/* 按键放大后,箭头和字也跟着放大 */
.cbtn .arr-left  { border-top-width: 18rpx; border-bottom-width: 18rpx; border-right-width: 26rpx; }
.cbtn .arr-right { border-top-width: 18rpx; border-bottom-width: 18rpx; border-left-width: 26rpx; }
.cbtn .arr-down  { border-left-width: 18rpx; border-right-width: 18rpx; border-top-width: 26rpx; }
.cbtn .wood-key-text { font-size: 28rpx; }
.cbtn .rot-glyph { font-size: 52rpx; }
.cbtn .rot-main { font-size: 60rpx; }
.cbtn .drop-bar { width: 44rpx; }
