/* 木质 3D 主题:通用部分在 styles/wood.wxss,这里只放俄罗斯方块自己的布局 */
@import "../../styles/wood.wxss";

page {
  background: #26150A;
}

.header-left {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 140rpx;
}

.header-lv-num {
  font-size: 42rpx;
  font-weight: 700;
  font-family: monospace;
}

.header-lv-label {
  font-size: 22rpx;
  color: #F3D3A0;
  font-family: monospace;
  text-shadow: 0 2rpx 0 rgba(50, 25, 8, 0.7);
}

.header-center {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pause-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 2rpx;
  background: #4A2810;
  box-shadow: 0 2rpx 0 rgba(255, 235, 200, 0.45);
}

.mute-icon { font-size: 36rpx; }

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 140rpx;
}

/* ── 主区域 ── */
.main-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  min-height: 0;
  padding: 12rpx 12rpx 0;
  gap: 10rpx;
}

.board-wrap {
  flex: 1;
  min-width: 0;
}

.board-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.side-panel {
  width: 168rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 12rpx;
}

.side-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hold-canvas {
  width: 150rpx;
  height: 130rpx;
  display: block;
  border-radius: 12rpx;
  box-shadow: 0 0 0 4rpx #6E4222, 0 0 0 6rpx #3A200E, 0 8rpx 14rpx rgba(0, 0, 0, 0.5);
  margin-left: 6rpx;
}

.next-canvas {
  width: 150rpx;
  height: 340rpx;
  display: block;
  border-radius: 12rpx;
  box-shadow: 0 0 0 4rpx #6E4222, 0 0 0 6rpx #3A200E, 0 8rpx 14rpx rgba(0, 0, 0, 0.5);
  margin-left: 6rpx;
}

/* 统计:一块小木牌 */
.stats {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 10rpx 0 0 4rpx;
  padding: 14rpx 16rpx;
}

.stat-row {
  display: flex;
  flex-direction: column;
}

/* ── 操作区:木质控制台 ── */
.controls {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 22rpx 28rpx 44rpx;
}

.controls-hidden { visibility: hidden; }

.ctrl-cluster {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.ctrl-row {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
}

.cbtn {
  width: 156rpx;
  height: 104rpx;
}

.cbtn-wide { width: 326rpx; }

.rot-glyph {
  font-size: 44rpx;
  font-weight: 700;
  color: #5A3216;
  font-family: monospace;
  line-height: 1;
  text-shadow: 0 2rpx 0 rgba(255, 238, 210, 0.55);
}

.rot-main {
  font-size: 52rpx;
  color: #3E1E08;
}

.drop-glyph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.drop-arr { border-top-color: #FFEBD2; }

.drop-bar {
  width: 36rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: #FFEBD2;
}

/* 按键放大后,箭头和字也跟着放大 */
.cbtn .arr-left  { border-top-width: 18rpx; border-bottom-width: 18rpx; border-right-width: 26rpx; }
.cbtn .arr-right { border-top-width: 18rpx; border-bottom-width: 18rpx; border-left-width: 26rpx; }
.cbtn .arr-down  { border-left-width: 18rpx; border-right-width: 18rpx; border-top-width: 26rpx; }
.cbtn .wood-key-text { font-size: 28rpx; }
.cbtn .rot-glyph { font-size: 52rpx; }
.cbtn .rot-main { font-size: 60rpx; }
.cbtn .drop-bar { width: 44rpx; }

/* ── 模式 ── */
.mode-tag {
  align-self: flex-start;
  margin-bottom: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #5A3A08;
  background: linear-gradient(180deg, #FFE18A 0%, #E0A93E 100%);
  box-shadow: 0 2rpx 0 #7A5212;
  white-space: nowrap;
}

/* 选模式时压暗得轻一点,能看到后面的空托盘 */
.overlay-soft {
  background: rgba(14, 7, 2, 0.55);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.mode-plaque {
  width: 600rpx;
}

.mode-body {
  padding: 30rpx 30rpx 40rpx;
  gap: 22rpx;
}

/* 每个模式一块浅色木片,按下沉一下 */
.mode-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #E2B37A 0%, #C48C52 60%, #AE7640 100%);
  border: 2rpx solid #5E3519;
  box-shadow: 0 8rpx 0 #5A3218, 0 12rpx 14rpx rgba(0, 0, 0, 0.35), inset 0 3rpx 0 rgba(255, 244, 220, 0.6);
}

.mode-card:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #5A3218, inset 0 3rpx 6rpx rgba(80, 40, 10, 0.35);
}

/* 上次玩的模式:金色 */
.mode-current {
  background: linear-gradient(180deg, #FFE18A 0%, #E0A93E 100%);
  border-color: #7A5212;
  box-shadow: 0 8rpx 0 #7A5212, 0 12rpx 14rpx rgba(0, 0, 0, 0.35), inset 0 3rpx 0 rgba(255, 250, 230, 0.7);
}

.mode-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.mode-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A2810;
  text-shadow: 0 2rpx 0 rgba(255, 238, 210, 0.5);
}

.mode-desc {
  font-size: 22rpx;
  color: #6A3E1C;
}

.mode-best {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #7A2A14;
  font-family: monospace;
}
