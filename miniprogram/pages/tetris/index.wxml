<view class="wood-page">
  <!-- 顶部信息栏 -->
  <view class="wood-header">
    <view class="header-left">
      <text class="header-lv-label">LV.</text><text class="header-lv-num head-gold">{{level}}</text>
    </view>
    <view class="header-center">
      <view class="wood-knob" catchtouchstart="onPause" wx:if="{{gameState === 'playing'}}">
        <view class="pause-bar"></view>
        <view class="pause-bar"></view>
      </view>
      <view class="wood-knob wood-knob-disabled" wx:else></view>
      <view class="wood-knob" catchtouchstart="onToggleMute">
        <text class="mute-icon">{{muted ? '🔇' : '🔊'}}</text>
      </view>
    </view>
    <view class="header-right">
      <text class="head-label">{{hudLabel}}</text>
      <text class="head-value">{{hudValue}}</text>
    </view>
  </view>

  <!-- 棋盘 + 侧栏 -->
  <view class="main-area">
    <view class="board-wrap"
          bindtouchstart="onBoardTouchStart"
          bindtouchmove="onBoardTouchMove"
          bindtouchend="onBoardTouchEnd">
      <canvas id="tetris-canvas" type="2d" class="board-canvas"></canvas>
    </view>

    <view class="side-panel">
      <view class="side-section" catchtouchend="onHold">
        <text class="wood-label">HOLD</text>
        <canvas id="hold-canvas" type="2d" class="hold-canvas"></canvas>
      </view>

      <view class="side-section">
        <text class="wood-label">NEXT</text>
        <canvas id="next-canvas" type="2d" class="next-canvas"></canvas>
      </view>

      <view class="wood-plate stats">
        <text class="mode-tag">{{modeName}}</text>
        <view class="stat-row">
          <text class="plate-label">{{stat1Label}}</text>
          <text class="plate-value">{{stat1Value}}</text>
        </view>
        <view class="stat-row">
          <text class="plate-label">{{stat2Label}}</text>
          <text class="plate-value">{{stat2Value}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作区:左移动/软降,右旋转/硬降。
       非游戏中只隐藏不移除:移除会让棋盘区变高,画布被拉伸 -->
  <view class="wood-console controls {{gameState === 'playing' ? '' : 'controls-hidden'}}" catchtouchend="noop">
    <view class="ctrl-cluster">
      <view class="ctrl-row">
        <view class="wood-key cbtn" catchtouchstart="onLeft" catchtouchend="onMoveEnd" catchtouchcancel="onMoveEnd">
          <view class="arr arr-left"></view>
        </view>
        <view class="wood-key cbtn" catchtouchstart="onRight" catchtouchend="onMoveEnd" catchtouchcancel="onMoveEnd">
          <view class="arr arr-right"></view>
        </view>
      </view>
      <view class="ctrl-row">
        <view class="wood-key cbtn cbtn-wide" catchtouchstart="onDown" catchtouchend="onDownEnd" catchtouchcancel="onDownEnd">
          <view class="arr arr-down"></view>
          <text class="wood-key-text">软降</text>
        </view>
      </view>
    </view>

    <view class="ctrl-cluster">
      <view class="ctrl-row">
        <view class="wood-key cbtn" catchtouchstart="onRotCCW">
          <text class="rot-glyph">⟲</text>
        </view>
        <view class="wood-key cbtn" catchtouchstart="onRotCW">
          <text class="rot-glyph rot-main">⟳</text>
        </view>
      </view>
      <view class="ctrl-row">
        <view class="wood-key wood-key-red cbtn cbtn-wide" catchtouchstart="onDrop">
          <view class="drop-glyph">
            <view class="arr arr-down drop-arr"></view>
            <view class="drop-bar"></view>
          </view>
          <text class="wood-key-text wood-key-text-light">硬降</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 选模式 -->
  <view class="overlay overlay-soft" wx:if="{{gameState === 'menu'}}">
    <view class="plaque mode-plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">选择玩法</text>
      </view>
      <view class="plaque-body mode-body">
        <view
          wx:for="{{modeList}}"
          wx:key="id"
          class="mode-card {{item.current ? 'mode-current' : ''}}"
          data-mode="{{item.id}}"
          catchtap="onPickMode"
        >
          <view class="mode-main">
            <text class="mode-name">{{item.name}}</text>
            <text class="mode-desc">{{item.desc}}</text>
          </view>
          <text class="mode-best">{{item.best}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 暂停 -->
  <view class="overlay" wx:if="{{gameState === 'paused'}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">暂停</text>
      </view>
      <view class="plaque-body">
        <text class="score-label">{{modeName}} · {{hudLabel === 'TIME' ? '用时' : '当前得分'}}</text>
        <text class="score-num">{{hudValue}}</text>
        <view class="btn-col btn-col-gap">
          <view class="wbtn wbtn-primary" catchtouchstart="onResume">继续游戏</view>
          <view class="wbtn" catchtouchstart="onRestart">重新开始</view>
          <view class="wbtn" catchtouchstart="onChangeMode">换个玩法</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 结束 -->
  <view class="overlay" wx:if="{{gameState === 'over' && !!result}}">
    <view class="plaque">
      <view class="nail nail-tl"></view>
      <view class="nail nail-tr"></view>
      <view class="nail nail-bl"></view>
      <view class="nail nail-br"></view>
      <view class="plaque-head">
        <text class="plaque-title">{{result.title}}</text>
      </view>
      <view class="plaque-body">
        <view class="newbest-badge" wx:if="{{isNewBest}}">
          <text class="newbest-text">新纪录</text>
        </view>
        <text class="score-label" wx:else>{{modeName}} · {{result.mainLabel}}</text>
        <text class="score-num">{{result.main}}</text>
        <view class="stat-grid">
          <view class="stat-cell" wx:for="{{result.cells}}" wx:key="label">
            <text class="cell-label">{{item.label}}</text>
            <text class="cell-value">{{item.value}}</text>
          </view>
        </view>
        <view class="btn-col">
          <view class="wbtn wbtn-primary" catchtouchstart="onRestart">再来一局</view>
          <view class="wbtn" catchtouchstart="onChangeMode">换个玩法</view>
          <button class="wbtn wbtn-share" open-type="share">分享战绩</button>
        </view>
      </view>
    </view>
  </view>
</view>
